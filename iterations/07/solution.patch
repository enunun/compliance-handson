diff --git a/app/ops/monitoring/alertmanager.yml b/app/ops/monitoring/alertmanager.yml
new file mode 100644
index 0000000..b0dc180
--- /dev/null
+++ b/app/ops/monitoring/alertmanager.yml
@@ -0,0 +1,17 @@
+# Alertmanagerの設定．アラートの重大度(severity)で通知先を分ける．
+# 通知先のURLは例である．本番では，チャットやオンコールの道具の受け口に替える．
+route:
+  receiver: team-chat
+  group_by: [alertname]
+  routes:
+    # すぐに対応が要るアラートは，オンコールの担当者に知らせる．
+    - matchers: ['severity="page"']
+      receiver: on-call
