+# アラートのルールのテスト．mise run test:alerts で promtool が実行する．
+rule_files:
+  - ../../ops/monitoring/rules.yml
+
+evaluation_interval: 1m
+
+tests:
+  # エラーの割合が10%(1分に200件のうち20件)なら，5分続いた後で知らせる．
+  - interval: 1m
+    input_series:
+      - series: 'http_requests_total{route="GET /api/notes",code="200"}'
+        values: "0+180x30"
+      - series: 'http_requests_total{route="GET /api/notes",code="500"}'
+        values: "0+20x30"
+    alert_rule_test:
+      - eval_time: 3m
+        alertname: ApiHighErrorRate
+        exp_alerts: []
+      - eval_time: 15m
+        alertname: ApiHighErrorRate
+        exp_alerts:
+          - exp_labels:
+              severity: page
+            exp_annotations:
+              summary: APIのエラーの割合が5%を超えている
+              runbook: ops/runbooks/api-high-error-rate.md
+
+  # エラーの割合が1%なら知らせない．
+  - interval: 1m
+    input_series:
+      - series: 'http_requests_total{route="GET /api/notes",code="200"}'
+        values: "0+198x30"
+      - series: 'http_requests_total{route="GET /api/notes",code="500"}'
+        values: "0+2x30"
+    alert_rule_test:
+      - eval_time: 20m
+        alertname: ApiHighErrorRate
+        exp_alerts: []
+
+  # エラーが止まれば，知らせるのをやめる．
+  - interval: 1m
+    input_series:
+      - series: 'http_requests_total{route="GET /api/notes",code="200"}'
+        values: "0+180x40"
+      - series: 'http_requests_total{route="GET /api/notes",code="500"}'
+        values: "0+20x15 300x25"
+    alert_rule_test:
+      - eval_time: 15m
+        alertname: ApiHighErrorRate
+        exp_alerts:
+          - exp_labels:
+              severity: page
+            exp_annotations:
+              summary: APIのエラーの割合が5%を超えている
+              runbook: ops/runbooks/api-high-error-rate.md
+      - eval_time: 30m
+        alertname: ApiHighErrorRate
+        exp_alerts: []
