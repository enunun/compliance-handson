+++ b/app/tools/ops/alerts.ts
@@ -0,0 +1,33 @@
+import type { Standards } from "./standards.ts";
+
+/** アラートのルール(ops/monitoring/rules.yml)の場所． */
+export function alertRulesPath(opsDir: string): string {
+  return `${opsDir}/monitoring/rules.yml`;
+}
+
+/**
+ * Prometheusのアラートのルールを作る．しきい値は基準値から取る．
+ * 生成したファイルは ops:verify で基準値と照らし合わせる．
+ */
+export function alertRules(standards: Standards) {
+  const { error_rate_threshold, error_rate_for } = standards.monitoring;
+  return {
+    groups: [
+      {
+        name: "api",
+        rules: [
+          {
+            alert: "ApiHighErrorRate",
+            expr: `sum(rate(http_requests_total{code=~"5.."}[5m])) / sum(rate(http_requests_total[5m])) > ${error_rate_threshold}`,
+            for: error_rate_for,
+            labels: { severity: "page" },
+            annotations: {
+              summary: `APIのエラーの割合が${error_rate_threshold * 100}%を超えている`,
+              runbook: "ops/runbooks/api-high-error-rate.md",
+            },
+          },
+        ],
+      },
+    ],
+  };
+}
