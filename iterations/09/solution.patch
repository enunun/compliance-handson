diff --git a/app/tests/ops/backup.test.ts b/app/tests/ops/backup.test.ts
new file mode 100644
index 0000000..844ec53
--- /dev/null
+++ b/app/tests/ops/backup.test.ts
@@ -0,0 +1,91 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { Ajv2020 } from "ajv/dist/2020.js";
+import { beforeAll, describe, expect, it } from "vitest";
+import { parse } from "yaml";
+import { logLineSchema, readLogs } from "../../tools/ops/logs.ts";
+import { appRoot, evidenceDir, run } from "../gates/helpers.ts";
+
+// 本番の環境(mise run up で作った環境)で，バックアップとリストアの訓練を動かして確かめる．
+const rows = 7;
+let backup: ReturnType<typeof run>;
+let restore: ReturnType<typeof run>;
+
+function tofuOutput(name: string): string {
+  return run("tofu", ["-chdir=infra", "output", "-raw", name]).output;
+}
+
+beforeAll(() => {
+  // 戻した後で数を比べるための行を用意する．
+  const databaseUrl = tofuOutput("database_url");
+  run("psql", [
+    databaseUrl,
+    "-c",
+    `DROP TABLE IF EXISTS restore_check; CREATE TABLE restore_check AS SELECT generate_series(1, ${rows}) AS n`,
+  ]);
+  backup = run("pnpm", ["exec", "tsx", "tools/ops/backup.ts"]);
+  restore = run("pnpm", ["exec", "tsx", "tools/ops/restore-test.ts"]);
+}, 300_000);
+
+describe("バックアップとリストアの訓練", () => {
+  it("バックアップを取り，バックアップの保管場所に置く", () => {
+    expect(backup.status, backup.output).toBe(0);
+    const result = JSON.parse(
+      readFileSync(join(evidenceDir, "backup/result.json"), "utf8"),
+    );
+    expect(result.rows.restore_check).toBe(rows);
+  });
+
+  it("最新のバックアップを新しいデータベースに戻し，行数が一致する", () => {
+    expect(restore.status, restore.output).toBe(0);
+    const result = JSON.parse(
+      readFileSync(join(evidenceDir, "restore-test/result.json"), "utf8"),
+    );
+    expect(result.ok).toBe(true);
+    expect(result.tables.restore_check).toEqual({
+      backup: rows,
+      restored: rows,
+    });
+  });
+
+  it("バックアップの保管場所は，基準値の日数だけ消せない設定である", () => {
+    const standards = parse(
+      readFileSync(join(appRoot, "ops/standards.yaml"), "utf8"),
+    );
+    const result = run("aws", [
+      "s3api",
+      "get-object-lock-configuration",
+      "--bucket",
+      tofuOutput("backup_bucket"),
+    ]);
+    expect(
+      JSON.parse(result.output).ObjectLockConfiguration.Rule.DefaultRetention,
+    ).toEqual({
+      Mode: "COMPLIANCE",
+      Days: standards.backup.retention_days,
+    });
+  });
+
+  it("作業の記録が ops のロググループに残り，ログの設計に合う", () => {
+    const result = run("aws", [
+      "logs",
+      "filter-log-events",
+      "--log-group-name",
+      "/app/ops",
+    ]);
+    const lines = (
+      JSON.parse(result.output).events as { message: string }[]
+    ).map((e) => JSON.parse(e.message));
+    const validate = new Ajv2020().compile(
