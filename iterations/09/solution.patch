+name: backup
+
+# データベースのバックアップとリストアの訓練．standards.yaml の backup.interval_hours(24時間)ごとに動かす．
+# この題材では，データベースはジョブの中で起動したMiniStackの上に作る．
+on:
+  schedule:
+    - cron: "17 18 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  backup:
+    runs-on: ubuntu-latest
+    services:
+      ministack:
+        image: ministackorg/ministack:1.5.21@sha256:7a30ff0670578e10528b5a9a21e795ef494f96bbc35691c9b0742ea35de71808
+        ports:
+          - 4566:4566
+        volumes:
+          - /var/run/docker.sock:/var/run/docker.sock
+        options: --workdir /opt/ministack
+    env:
+      AWS_ENDPOINT_URL: http://localhost:4566
+      AWS_ACCESS_KEY_ID: test
+      AWS_SECRET_ACCESS_KEY: test
+      AWS_REGION: ap-northeast-1
+      AWS_CONFIG_FILE: ${{ github.workspace }}/.devcontainer/aws-config
+      LOG_GROUP_PREFIX: /app/
+    defaults:
+      run:
+        working-directory: app
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+      - run: echo "127.0.0.1 000000000000.localhost" | sudo tee -a /etc/hosts
+      - uses: jdx/mise-action@5228313ee0372e111a38da051671ca30fc5a96db # v3.6.3
+      - run: mise run up
+      - run: mise run ops:backup
+      - run: mise run ops:restore-test
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: always()
+        with:
+          name: evidence-backup
+          path: app/out/evidence/
diff --git a/app/infra/backup.tf b/app/infra/backup.tf
new file mode 100644
index 0000000..d032590
--- /dev/null
+++ b/app/infra/backup.tf
@@ -0,0 +1,56 @@
+# データベースのバックアップの保管場所．Object Lock(COMPLIANCE)で，保管期間の間は誰も消せない．
+resource "aws_s3_bucket" "backups" {
+  bucket              = "app-backups"
+  object_lock_enabled = true
+}
+
+resource "aws_s3_bucket_versioning" "backups" {
+  bucket = aws_s3_bucket.backups.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_object_lock_configuration" "backups" {
+  bucket = aws_s3_bucket.backups.id
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = local.standards.backup.retention_days
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.backups]
+}
+
+resource "aws_s3_bucket_public_access_block" "backups" {
+  bucket                  = aws_s3_bucket.backups.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_server_side_encryption_configuration" "backups" {
+  bucket = aws_s3_bucket.backups.id
+  rule {
+    apply_server_side_encryption_by_default {
+      sse_algorithm     = "aws:kms"
+      kms_master_key_id = aws_kms_key.storage.arn
+    }
+  }
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "backups" {
+  bucket = aws_s3_bucket.backups.id
+  rule {
+    id     = "expire-after-retention"
+    status = "Enabled"
+    filter {}
+    noncurrent_version_expiration {
+      noncurrent_days = local.standards.backup.retention_days + 1
+    }
+    expiration {
+      days = local.standards.backup.retention_days + 1
+    }
+  }
+}
