diff --git a/app/tools/ops/backup.ts b/app/tools/ops/backup.ts
new file mode 100644
index 0000000..145238a
--- /dev/null
+++ b/app/tools/ops/backup.ts
@@ -0,0 +1,34 @@
+// データベースをバックアップし，バックアップの保管場所に置く．
+// バックアップした時点の各テーブルの行数も一緒に置き，リストアの訓練で比べる．
+import { createHash } from "node:crypto";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { countRows, evidenceDir, opsLog, sh, tofuOutput } from "./run.ts";
+
+try {
+  const databaseUrl = process.env.DATABASE_URL ?? tofuOutput("database_url");
+  const bucket = tofuOutput("backup_bucket");
+  const stamp = new Date().toISOString().replace(/[:.]/g, "-");
+  const key = `${stamp.slice(0, 10)}/app-${stamp}.dump`;
+
+  mkdirSync("out/backup", { recursive: true });
+  const file = join("out/backup", `app-${stamp}.dump`);
+  const rows = countRows(databaseUrl);
+  sh("pg_dump", ["--format=custom", "--file", file, databaseUrl]);
+  const sha256 = createHash("sha256").update(readFileSync(file)).digest("hex");
+
+  const countsFile = `${file}.rows.json`;
+  writeFileSync(countsFile, JSON.stringify(rows));
+  sh("aws", ["s3", "cp", file, `s3://${bucket}/${key}`]);
+  sh("aws", ["s3", "cp", countsFile, `s3://${bucket}/${key}.rows.json`]);
+
+  const result = { time: new Date().toISOString(), bucket, key, sha256, rows };
+  writeFileSync(
+    join(evidenceDir("backup"), "result.json"),
+    JSON.stringify(result, null, 2),
+  );
+  opsLog("backup", true, `s3://${bucket}/${key} sha256=${sha256}`);
+} catch (error) {
+  opsLog("backup", false, String(error));
+  process.exit(1);
+}
diff --git a/app/tools/ops/restore-test.ts b/app/tools/ops/restore-test.ts
new file mode 100644
index 0000000..158e0b5
--- /dev/null
+++ b/app/tools/ops/restore-test.ts
@@ -0,0 +1,122 @@
+// リストアの訓練．最新のバックアップを新しいデータベースに戻し，
+// バックアップした時点の各テーブルの行数と一致するかを確かめる．訓練に使ったデータベースは消す．
+import { randomBytes } from "node:crypto";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { countRows, evidenceDir, opsLog, sh, tofuOutput } from "./run.ts";
+
+const instance = `restore-test-${Date.now()}`;
+let created = false;
+try {
+  const bucket = tofuOutput("backup_bucket");
+  const objects = JSON.parse(
+    sh("aws", ["s3api", "list-objects-v2", "--bucket", bucket]),
+  ).Contents as { Key: string; LastModified: string }[];
+  const latest = objects
+    .filter((o) => o.Key.endsWith(".dump"))
+    .sort((a, b) => a.LastModified.localeCompare(b.LastModified))
+    .at(-1);
+  if (!latest) {
+    throw new Error("バックアップがない");
+  }
+  mkdirSync("out/backup", { recursive: true });
+  const file = "out/backup/restore.dump";
+  sh("aws", ["s3", "cp", `s3://${bucket}/${latest.Key}`, file]);
+  sh("aws", [
+    "s3",
+    "cp",
+    `s3://${bucket}/${latest.Key}.rows.json`,
+    `${file}.rows.json`,
+  ]);
+  const expected = JSON.parse(
+    readFileSync(`${file}.rows.json`, "utf8"),
+  ) as Record<string, number>;
+
+  // 訓練用のデータベースを作る．
+  const password = randomBytes(16).toString("hex");
+  sh("aws", [
+    "rds",
+    "create-db-instance",
+    "--db-instance-identifier",
+    instance,
+    "--engine",
+    "postgres",
+    "--engine-version",
+    "15",
+    "--db-instance-class",
+    "db.t3.micro",
+    "--allocated-storage",
+    "20",
+    "--db-name",
+    "app",
+    "--master-username",
+    "app",
+    "--master-user-password",
+    password,
+  ]);
+  created = true;
+  sh("aws", [
+    "rds",
+    "wait",
+    "db-instance-available",
+    "--db-instance-identifier",
+    instance,
+  ]);
+  const endpoint = JSON.parse(
+    sh("aws", [
+      "rds",
+      "describe-db-instances",
+      "--db-instance-identifier",
+      instance,
+    ]),
+  ).DBInstances[0].Endpoint as { Address: string; Port: number };
+  const url = `postgres://app:${password}@${endpoint.Address}:${endpoint.Port}/app`;
+
+  // データベースが接続を受け付けるまで待ってから戻す．
+  for (let i = 0; ; i++) {
+    try {
+      sh("psql", [url, "-tAc", "SELECT 1"]);
+      break;
+    } catch (error) {
+      if (i >= 30) throw error;
+      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 2000);
+    }
+  }
+  sh("pg_restore", ["--no-owner", "--dbname", url, file]);
+  const restored = countRows(url);
+
+  const tables = Object.fromEntries(
+    Object.keys(expected).map((t) => [
+      t,
+      { backup: expected[t], restored: restored[t] ?? 0 },
+    ]),
+  );
+  const ok = Object.values(tables).every((t) => t.backup === t.restored);
+  const result = {
+    time: new Date().toISOString(),
+    backup: latest.Key,
+    ok,
+    tables,
+  };
+  writeFileSync(
+    join(evidenceDir("restore-test"), "result.json"),
+    JSON.stringify(result, null, 2),
+  );
+  opsLog("restore-test", ok, `${latest.Key} ${JSON.stringify(tables)}`);
+  if (!ok) {
+    process.exitCode = 1;
+  }
+} catch (error) {
+  opsLog("restore-test", false, String(error));
+  process.exitCode = 1;
+} finally {
+  if (created) {
+    sh("aws", [
+      "rds",
+      "delete-db-instance",
+      "--db-instance-identifier",
+      instance,
+      "--skip-final-snapshot",
+    ]);
+  }
+}
diff --git a/app/tools/ops/run.ts b/app/tools/ops/run.ts
new file mode 100644
index 0000000..466114d
--- /dev/null
+++ b/app/tools/ops/run.ts
@@ -0,0 +1,83 @@
+// 運用の作業のスクリプトに共通の処理．
+import { spawnSync } from "node:child_process";
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";
+
+/** コマンドを実行し，標準出力を返す．失敗したら例外を投げる． */
+export function sh(command: string, args: string[], input?: string): string {
+  const result = spawnSync(command, args, { encoding: "utf8", input });
+  if (result.status !== 0) {
+    throw new Error(`${command} ${args[0]} failed: ${result.stderr.trim()}`);
+  }
+  return result.stdout.trim();
+}
+
+/** OpenTofuの出力を読む． */
+export function tofuOutput(name: string): string {
+  return sh("tofu", ["-chdir=infra", "output", "-raw", name]);
+}
+
+/** 証跡の置き場所．ゲートのテストや運用テストでは EVIDENCE_DIR で替える． */
+export function evidenceDir(name: string): string {
+  const dir = join(process.env.EVIDENCE_DIR ?? "out/evidence", name);
+  mkdirSync(dir, { recursive: true });
+  return dir;
+}
+
+/**
+ * 運用の作業の記録(ops/logs.yaml の ops)を1行書く．
+ * LOG_GROUP_PREFIX があれば，CloudWatch Logsのロググループ(<prefix>ops)にも送る．
+ */
+export function opsLog(job: string, succeeded: boolean, detail: string): void {
+  const line = JSON.stringify({
+    time: new Date().toISOString(),
+    level: succeeded ? "INFO" : "ERROR",
+    msg: `${job} ${succeeded ? "succeeded" : "failed"}`,
+    log_type: "ops",
+    job,
+    result: succeeded ? "succeeded" : "failed",
+    detail,
+  });
+  console.log(line);
+  const prefix = process.env.LOG_GROUP_PREFIX;
+  if (!prefix) {
+    return;
+  }
+  const group = `${prefix}ops`;
+  // ストリームがすでにあれば失敗するが，そのまま書き込む．
+  spawnSync("aws", [
+    "logs",
+    "create-log-stream",
+    "--log-group-name",
+    group,
+    "--log-stream-name",
+    job,
+  ]);
+  sh("aws", [
+    "logs",
+    "put-log-events",
+    "--log-group-name",
+    group,
+    "--log-stream-name",
+    job,
+    "--log-events",
+    JSON.stringify([{ timestamp: Date.now(), message: line }]),
+  ]);
+}
+
+/** データベースの各テーブルの行数を数える． */
+export function countRows(databaseUrl: string): Record<string, number> {
+  const tables = sh("psql", [
+    databaseUrl,
+    "-tAc",
+    "SELECT tablename FROM pg_tables WHERE schemaname = 'public' ORDER BY tablename",
+  ])
+    .split("\n")
+    .filter(Boolean);
+  return Object.fromEntries(
+    tables.map((t) => [
+      t,
+      Number(sh("psql", [databaseUrl, "-tAc", `SELECT count(*) FROM "${t}"`])),
+    ]),
+  );
+}
