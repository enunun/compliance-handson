+import { describe, expect, it } from "vitest";
+import { fixture, run } from "./helpers.ts";
+
+/** fixtures/sla/<name>.yaml の例外を，2026-10-04 の時点で検査する． */
+function sla(name: string) {
+  return run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/gates/sla.ts",
+    "--exceptions",
+    fixture("sla", `${name}.yaml`),
+    "--today",
+    "2026-10-04",
+  ]);
+}
+
+describe("gate:sla", () => {
+  it("影響がある脆弱性が，直すまでの期限を過ぎていれば失敗する", () => {
+    const result = sla("overdue");
+    expect(result.output).toContain(
+      "EXC-001: CVE-0000-0001(HIGH)は直す期限(2026-09-19)を過ぎている",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("例外の期限が，直すまでの期限を超えていれば失敗する", () => {
+    const result = sla("beyond-sla");
+    expect(result.output).toContain(
+      "EXC-001: 例外の期限(2026-12-31)が直す期限(2026-10-20)を超えている",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("期限内のものと，影響がないものだけなら通る", () => {
+    const result = sla("within");
+    expect(result.output).toContain(
+      "sla: 1 affected, 1 not_affected, 0 overdue",
+    );
+    expect(result.status).toBe(0);
+  });
+});
