+++ b/app/tools/gates/trivy.ts
@@ -17,16 +17,44 @@ export function evidenceDirOf(gate: string): string {
   return dir;
 }
 
-/** 例外を，Trivyの除外の設定(.trivyignore.yaml の形)に変える．脆弱性と設定の誤りの両方に使う． */
+/**
+ * 例外を，Trivyの除外の設定(.trivyignore.yaml の形)に変える．
+ * 影響がない(not_affected)脆弱性は，除外ではなくOpenVEXの文書(toOpenVex)で伝える．
+ */
 export function toTrivyIgnore(exceptions: Exception[]) {
-  const entries = exceptions.map((e) => ({
-    id: e.target,
-    statement: `${e.id}: ${e.reason} (承認：${e.approver})`,
-    expired_at: e.expires,
-  }));
+  const entries = exceptions
+    .filter((e) => e.status !== "not_affected")
+    .map((e) => ({
+      id: e.target,
+      statement: `${e.id}: ${e.reason} (承認：${e.approver})`,
+      expired_at: e.expires,
+    }));
