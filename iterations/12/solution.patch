@@ -0,0 +1,67 @@
+import { join } from "node:path";
+import { Ajv2020 } from "ajv/dist/2020.js";
+import { beforeAll, describe, expect, it } from "vitest";
+import { logLineSchema, readLogs } from "../../tools/ops/logs.ts";
+import { appRoot, fixture, run } from "../gates/helpers.ts";
+
+// 期限を過ぎた脆弱性が，Alertmanagerからオンコールの担当者へ届くことを確かめる．
+// Dev ContainerのAlertmanager(mise run up は要らない)と，運用の作業の記録のためにMiniStackを使う．
+const alertmanager = process.env.ALERTMANAGER_URL ?? "http://localhost:9093";
+let sla: ReturnType<typeof run>;
+
+beforeAll(() => {
+  sla = run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/gates/sla.ts",
+    "--exceptions",
+    fixture("sla", "overdue.yaml"),
+    "--today",
+    "2026-10-04",
+    "--alertmanager",
+    alertmanager,
+  ]);
+});
+
+describe("期限切れのエスカレーション", () => {
+  it("期限を過ぎた脆弱性を，オンコールの担当者へのアラートとして送る", async () => {
+    expect(sla.status).toBe(1);
+    const res = await fetch(
+      `${alertmanager}/api/v2/alerts?filter=alertname="VulnerabilityOverdue"`,
+    );
+    const alerts = (await res.json()) as {
+      labels: Record<string, string>;
+      receivers: { name: string }[];
+    }[];
+    const alert = alerts.find(
+      (a) => a.labels.vulnerability === "CVE-0000-0001",
+    );
+    expect(alert?.labels.severity).toBe("page");
+    expect(alert?.receivers.map((r) => r.name)).toContain("on-call");
+  });
+
+  it("知らせたことが ops のロググループに残り，ログの設計に合う", () => {
+    const result = run("aws", [
+      "logs",
+      "filter-log-events",
+      "--log-group-name",
+      "/app/ops",
+      "--log-stream-names",
+      "escalation",
+    ]);
+    const lines = (
+      JSON.parse(result.output).events as { message: string }[]
+    ).map((e) => JSON.parse(e.message));
+    const validate = new Ajv2020().compile(
+      logLineSchema(readLogs(join(appRoot, "ops")), "ops"),
+    );
+    for (const line of lines) {
+      expect(validate(line), JSON.stringify(validate.errors)).toBe(true);
+    }
+    expect(lines.at(-1)).toMatchObject({
+      job: "escalation",
+      result: "succeeded",
+      detail: "VulnerabilityOverdue: EXC-001",
+    });
+  });
+});
diff --git a/app/tools/gates/sla.ts b/app/tools/gates/sla.ts
new file mode 100644
index 0000000..04b9914
--- /dev/null
+++ b/app/tools/gates/sla.ts
@@ -0,0 +1,130 @@
+// 脆弱性を直すまでの期限(SLA)を検査する．
+// 影響がある(affected)脆弱性の例外が，見つかった日から基準値の日数を過ぎていれば失敗する．
+// Alertmanagerの場所を渡すと，期限を過ぎたものを上位者へのアラートとして送る．
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+import { opsLog } from "../ops/run.ts";
+import {
+  type Exception,
+  readExceptions,
+  readStandards,
+  type Severity,
+} from "../ops/standards.ts";
+import { evidenceDirOf } from "./trivy.ts";
+
+const day = 24 * 60 * 60 * 1000;
+
+/** YYYY-MM-DD に日数を足す． */
+function addDays(date: string, days: number): string {
+  return new Date(Date.parse(date) + days * day).toISOString().slice(0, 10);
+}
+
+export type SlaResult = {
+  affected: Exception[];
+  notAffected: Exception[];
+  /** 直す期限を過ぎた例外と，その期限． */
+  overdue: { exception: Exception; due: string }[];
+  problems: string[];
+};
+
+/** 脆弱性の例外を，重大度ごとの日数(slaDays)と比べる．today は YYYY-MM-DD である． */
+export function checkSla(
+  exceptions: Exception[],
+  slaDays: Record<Severity, number>,
+  today: string,
+): SlaResult {
+  const result: SlaResult = {
+    affected: [],
+    notAffected: [],
+    overdue: [],
+    problems: [],
+  };
+  for (const e of exceptions) {
+    if (e.status === "not_affected") {
+      result.notAffected.push(e);
+      continue;
+    }
+    // SASTなど，脆弱性でない例外は対象にしない(トリアージの結果の有無は ops:verify が確かめる)．
+    if (e.status !== "affected" || !e.found || !e.severity) {
+      continue;
+    }
+    result.affected.push(e);
+    const due = addDays(e.found, slaDays[e.severity]);
+    if (today > due) {
+      result.overdue.push({ exception: e, due });
+      result.problems.push(
+        `${e.id}: ${e.target}(${e.severity})は直す期限(${due})を過ぎている`,
+      );
+    } else if (e.expires > due) {
+      result.problems.push(
+        `${e.id}: 例外の期限(${e.expires})が直す期限(${due})を超えている`,
+      );
+    }
+  }
+  return result;
+}
+
+/** 期限を過ぎた脆弱性を，AlertmanagerのAPIへアラートとして送る． */
+async function escalate(
+  alertmanager: string,
+  overdue: SlaResult["overdue"],
+): Promise<void> {
+  const alerts = overdue.map(({ exception: e, due }) => ({
+    labels: {
+      alertname: "VulnerabilityOverdue",
+      severity: "page",
+      exception: e.id,
+      vulnerability: e.target,
+    },
+    annotations: {
+      summary: `${e.target}(${e.severity}，${e.package})が直す期限(${due})を過ぎている`,
+      runbook: "ops/runbooks/vulnerability-triage.md",
+    },
+  }));
+  const res = await fetch(`${alertmanager}/api/v2/alerts`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(alerts),
+  });
+  const ids = overdue.map((o) => o.exception.id).join(", ");
+  opsLog("escalation", res.ok, `VulnerabilityOverdue: ${ids}`);
+  if (!res.ok) {
+    throw new Error(`Alertmanagerへの送信に失敗した: ${res.status}`);
+  }
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      ops: { type: "string", default: "ops" },
+      exceptions: { type: "string", default: "ops/exceptions.yaml" },
+      today: {
+        type: "string",
+        default: new Date().toISOString().slice(0, 10),
+      },
+      alertmanager: { type: "string", default: process.env.ALERTMANAGER_URL },
+    },
+  });
+  const result = checkSla(
+    readExceptions(values.exceptions),
+    readStandards(values.ops).vulnerability.sla_days,
+    values.today,
+  );
+  writeFileSync(
+    join(evidenceDirOf("sla"), "sla.json"),
+    `${JSON.stringify({ today: values.today, ...result }, null, 2)}\n`,
+  );
+  for (const problem of result.problems) {
+    console.error(problem);
+  }
+  if (values.alertmanager && result.overdue.length > 0) {
+    await escalate(values.alertmanager, result.overdue);
+  }
+  if (result.problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(
+    `sla: ${result.affected.length} affected, ${result.notAffected.length} not_affected, 0 overdue`,
+  );
+}
