diff --git a/app/apps/web/src/client-ip.test.ts b/app/apps/web/src/client-ip.test.ts
new file mode 100644
index 0000000..4e869df
--- /dev/null
+++ b/app/apps/web/src/client-ip.test.ts
@@ -0,0 +1,14 @@
+import { describe, expect, it } from "vitest";
+import { clientIp } from "./client-ip.ts";
+
+describe("clientIp", () => {
+  it("X-Forwarded-For の先頭のアドレスを返す", () => {
+    expect(clientIp("203.0.113.5, 10.0.0.1")).toBe("203.0.113.5");
+    expect(clientIp("2001:db8::1")).toBe("2001:db8::1");
+  });
+
+  it("アドレスの形でなければ undefined を返す", () => {
+    expect(clientIp("<script>")).toBeUndefined();
+    expect(clientIp(undefined)).toBeUndefined();
+  });
+});
diff --git a/app/apps/web/src/client-ip.ts b/app/apps/web/src/client-ip.ts
new file mode 100644
index 0000000..9a11098
--- /dev/null
+++ b/app/apps/web/src/client-ip.ts
@@ -0,0 +1,13 @@
+import ip from "ip";
+
+/**
+ * X-Forwarded-For の先頭(利用者の端末)のアドレスを返す．
+ * IPアドレスの形でなければ undefined を返す．
+ */
+export function clientIp(forwardedFor: string | undefined): string | undefined {
+  const first = forwardedFor?.split(",")[0]?.trim();
+  if (!first) {
+    return undefined;
+  }
+  return ip.isV4Format(first) || ip.isV6Format(first) ? first : undefined;
+}
