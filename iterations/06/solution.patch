index 0000000..d9317da
--- /dev/null
+++ b/app/tools/gates/verify-image.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# イメージの署名とprovenanceを検証し，結果を証跡に残す．
+# 使い方：tools/gates/verify-image.sh <イメージ>@<ダイジェスト>
+# 署名とprovenanceが，このリポジトリの release.yml で作られたものでなければ失敗する．
+set -euo pipefail
+
+ref="$1"
+repo="${GITHUB_REPOSITORY:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}"
+dir="${EVIDENCE_DIR:-out/evidence}/release"
+mkdir -p "$dir"
+
+cosign verify \
+  --certificate-identity-regexp "^https://github.com/${repo}/\.github/workflows/release\.yml@" \
+  --certificate-oidc-issuer https://token.actions.githubusercontent.com \
+  "$ref" > "$dir/cosign-verify.json"
+
+gh attestation verify "oci://${ref}" \
+  --repo "$repo" \
+  --signer-workflow "${repo}/.github/workflows/release.yml" \
+  --format json > "$dir/provenance-verify.json"
+
+echo "verified: ${ref}"
