+import { describe, expect, it } from "vitest";
+import { fixture, run } from "./helpers.ts";
+
+/** fixtures/pinning/<name> のワークフローを検査する． */
+function pinning(name: string) {
+  return run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/gates/pinning.ts",
+    "--workflows",
+    fixture("pinning", name),
+  ]);
+}
+
+describe("gate:pinning", () => {
+  it("タグやブランチで参照するactionやワークフローがあれば失敗する", () => {
+    const result = pinning("tag");
+    expect(result.output).toContain(
+      "ci.yml: actions/checkout@v5 がハッシュで固定されていない",
+    );
+    expect(result.output).toContain(
+      "lint.yml@main がハッシュで固定されていない",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("ハッシュで固定した参照と，同じリポジトリの中の参照だけなら通る", () => {
+    const result = pinning("pinned");
+    expect(result.output).toContain("all pinned");
+    expect(result.status).toBe(0);
+  });
+});
diff --git a/app/tools/gates/pinning.ts b/app/tools/gates/pinning.ts
new file mode 100644
index 0000000..2d9a26d
--- /dev/null
+++ b/app/tools/gates/pinning.ts
@@ -0,0 +1,43 @@
+// ワークフローが使うactionやreusable workflowが，コミットのハッシュで固定されているかを検査する．
+// タグやブランチは後から別のコミットを指すように変えられるので，ハッシュで固定する．
+import { readdirSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+import { readYaml } from "../ops/items.ts";
+
+type Workflow = {
+  jobs?: Record<string, { uses?: string; steps?: { uses?: string }[] }>;
+};
+
+/** ハッシュで固定されていない参照を返す．同じリポジトリの中の参照(./)は対象にしない． */
+export function unpinned(workflow: Workflow): string[] {
+  const refs = Object.values(workflow.jobs ?? {}).flatMap((job) => [
+    ...(job.uses ? [job.uses] : []),
+    ...(job.steps ?? []).flatMap((step) => (step.uses ? [step.uses] : [])),
+  ]);
+  return refs.filter(
+    (ref) =>
+      !ref.startsWith("./") &&
+      !/@[0-9a-f]{40}$/.test(ref) &&
+      !/^docker:\/\/.+@sha256:[0-9a-f]{64}$/.test(ref),
+  );
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: { workflows: { type: "string", default: "../.github/workflows" } },
+  });
+  const files = readdirSync(values.workflows).filter((f) => /\.ya?ml$/.test(f));
+  const problems = files.flatMap((file) =>
+    unpinned(readYaml(join(values.workflows, file)) as Workflow).map(
+      (ref) => `${file}: ${ref} がハッシュで固定されていない`,
+    ),
+  );
+  for (const problem of problems) {
+    console.error(problem);
+  }
+  if (problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(`pinning: ${files.length} workflows, all pinned`);
+}
