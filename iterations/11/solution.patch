@@ -0,0 +1,38 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { beforeAll, describe, expect, it } from "vitest";
+import { readDbSecret, toUrl } from "../../tools/ops/db.ts";
+import { evidenceDir, run } from "../gates/helpers.ts";
+
+// 本番の環境(mise run up で作った環境)で，パスワードの交換と権限の棚卸しを動かして確かめる．
+let before: ReturnType<typeof readDbSecret>;
+let rotate: ReturnType<typeof run>;
+let review: ReturnType<typeof run>;
+
+beforeAll(() => {
+  before = readDbSecret();
+  rotate = run("pnpm", ["exec", "tsx", "tools/ops/rotate-db-password.ts"]);
+  review = run("pnpm", ["exec", "tsx", "tools/ops/access-review.ts"]);
+}, 120_000);
+
+describe("パスワードの交換", () => {
+  it("新しいパスワードで接続でき，古いパスワードでは接続できない", () => {
+    expect(rotate.status, rotate.output).toBe(0);
+    const after = readDbSecret();
+    expect(after.password).not.toBe(before.password);
+    expect(run("psql", [toUrl(after), "-tAc", "SELECT 1"]).status).toBe(0);
+    expect(run("psql", [toUrl(before), "-tAc", "SELECT 1"]).status).not.toBe(0);
+  });
+});
+
+describe("権限の棚卸し", () => {
+  it("IAMの利用者とアクセスキー，CloudTrailの記録を報告に残す", () => {
+    expect(review.status, review.output).toBe(0);
+    const report = JSON.parse(
+      readFileSync(join(evidenceDir, "access-review/report.json"), "utf8"),
+    );
+    expect(report.access_key_holders).toEqual([]);
+    expect(report.iam_users.length).toBeGreaterThan(0);
+    expect(report.cloudtrail_events.length).toBeGreaterThan(0);
+  });
+});
