+// OpenTofuのコードの権限(IAM)を検査する．Trivyの既定のルールでは見つからない次の誤りを見つける．
+// - ポリシーを policies/ のJSONに分けず，コードの中に書いている(検査できない)．
+// - 長期のアクセスキー(aws_iam_access_key)を作っている．
+// - 許可のポリシーに，すべての操作(* や s3:*)やすべての対象(*)を書いている．
+// - GitHub Actions向けの信頼ポリシーが，引き受けられるリポジトリとブランチを絞っていない．
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+
+type Statement = {
+  Effect: string;
+  Action?: string | string[];
+  Resource?: string | string[];
+  Principal?: { Federated?: string };
+  Condition?: Record<string, Record<string, string | string[]>>;
+};
+
+const list = (v?: string | string[]) =>
+  v === undefined ? [] : Array.isArray(v) ? v : [v];
+const githubOidc = "token.actions.githubusercontent.com";
+// 引き受けられるのを，1つのリポジトリの1つのブランチか環境に絞った sub の形．
+const narrowSub =
+  /^repo:[^*/]+\/[^*]+:(ref:refs\/heads\/[^*]+|environment:[^*]+)$/;
+
+/** JSONのポリシーの問題を返す． */
+export function checkPolicy(
+  name: string,
+  policy: { Statement: Statement[] },
+): string[] {
+  return policy.Statement.flatMap((s) => {
+    if (s.Effect !== "Allow") return [];
+    const problems: string[] = [];
+    for (const action of list(s.Action)) {
+      if (action === "*" || action.endsWith(":*")) {
+        problems.push(`${name}: 操作 ${action} はすべての操作を許す`);
+      }
+    }
+    if (list(s.Resource).includes("*")) {
+      problems.push(`${name}: 対象 * はすべての対象を許す`);
+    }
+    if (s.Principal?.Federated !== undefined) {
+      const conditions = Object.values(s.Condition ?? {});
+      const aud = conditions.flatMap((c) => list(c[`${githubOidc}:aud`]));
+      const sub = conditions.flatMap((c) => list(c[`${githubOidc}:sub`]));
+      if (!aud.includes("sts.amazonaws.com")) {
+        problems.push(
+          `${name}: OIDCの aud を sts.amazonaws.com に絞っていない`,
+        );
+      }
+      // OpenTofuのテンプレートの変数(${...})は，固定の値として扱う．変数の値は，変数の validation で確かめる．
+      const fixed = sub.map((v) => v.replace(/\$\{[^}]+\}/g, "owner/repo"));
+      if (fixed.length === 0 || !fixed.every((v) => narrowSub.test(v))) {
+        problems.push(
+          `${name}: OIDCの sub を1つのリポジトリのブランチか環境に絞っていない(${sub.join(", ") || "なし"})`,
+        );
+      }
+    }
+    return problems;
+  });
+}
+
+/** OpenTofuのコードの問題を返す． */
+export function checkTerraform(name: string, text: string): string[] {
+  const problems: string[] = [];
+  if (/resource\s+"aws_iam_access_key"/.test(text)) {
+    problems.push(
+      `${name}: 長期のアクセスキー(aws_iam_access_key)を作っている．OIDCで一時的な認証情報を使う`,
+    );
+  }
+  if (/(policy|assume_role_policy)\s*=\s*jsonencode\(/.test(text)) {
+    problems.push(
+      `${name}: ポリシーをコードの中に書いている．policies/ のJSONに分ける`,
+    );
+  }
+  return problems;
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: { infra: { type: "string", default: "infra" } },
+  });
+  const tf = readdirSync(values.infra).filter((f) => f.endsWith(".tf"));
+  const policiesDir = join(values.infra, "policies");
+  let policies: string[] = [];
+  try {
+    policies = readdirSync(policiesDir).filter((f) => f.endsWith(".json"));
+  } catch {
+    // policies/ がなければ，JSONのポリシーはない．
+  }
+  const problems = [
+    ...tf.flatMap((f) =>
+      checkTerraform(f, readFileSync(join(values.infra, f), "utf8")),
+    ),
+    ...policies.flatMap((f) =>
+      checkPolicy(
+        `policies/${f}`,
+        JSON.parse(readFileSync(join(policiesDir, f), "utf8")),
+      ),
+    ),
+  ];
+  for (const problem of problems) {
+    console.error(problem);
+  }
+  if (problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(
+    `iam: ${tf.length} files, ${policies.length} policies, no problems`,
+  );
+}
diff --git a/app/tools/ops/access-review.ts b/app/tools/ops/access-review.ts
new file mode 100644
index 0000000..3a8cb51
--- /dev/null
+++ b/app/tools/ops/access-review.ts
@@ -0,0 +1,99 @@
+// 権限の棚卸しの報告を作る．
+// IAMの認証情報レポート(利用者と，アクセスキーの有無と古さ)，CloudTrailのIAMの操作の記録，
+// GitHubのリポジトリの協力者と権限をまとめ，証跡に残す．
+import { spawnSync } from "node:child_process";
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { evidenceDir, opsLog, sh } from "./run.ts";
+import { readStandards } from "./standards.ts";
+
+try {
+  const maxAge = readStandards("ops").credentials.max_age_days;
+  sh("aws", ["iam", "generate-credential-report"]);
+  const csv = Buffer.from(
+    sh("aws", [
+      "iam",
+      "get-credential-report",
+      "--query",
+      "Content",
+      "--output",
+      "text",
+    ]),
+    "base64",
+  ).toString("utf8");
+  const [header, ...rows] = csv
+    .trim()
+    .split("\n")
+    .map((l) => l.split(","));
+  const users = rows.map((r) =>
+    Object.fromEntries(header.map((h, i) => [h, r[i]])),
+  );
+
+  // 有効なアクセスキーと，基準値より古いアクセスキーを持つ利用者．
+  const now = Date.now();
+  const keyHolders = users.filter(
+    (u) => u.access_key_1_active === "true" || u.access_key_2_active === "true",
+  );
+  const staleKeys = keyHolders.filter((u) =>
+    ["access_key_1_last_rotated", "access_key_2_last_rotated"].some(
+      (k) =>
+        u[k] && u[k] !== "N/A" && now - Date.parse(u[k]) > maxAge * 86_400_000,
+    ),
+  );
+
+  const events = JSON.parse(
+    sh("aws", ["cloudtrail", "lookup-events", "--max-results", "50"]),
+  ).Events as {
+    EventName: string;
+    EventTime: string;
+    Username?: string;
+  }[];
+
+  // GitHubの協力者は，gh でログインしていれば取得する．
+  const gh = spawnSync(
+    "gh",
+    [
+      "api",
+      "repos/{owner}/{repo}/collaborators",
+      "--jq",
+      "[.[] | {login, role_name}]",
+    ],
+    {
+      encoding: "utf8",
+    },
+  );
+  const collaborators = gh.status === 0 ? JSON.parse(gh.stdout) : null;
+
+  const report = {
+    time: new Date().toISOString(),
+    iam_users: users.map((u) => u.user),
+    access_key_holders: keyHolders.map((u) => u.user),
+    stale_access_keys: staleKeys.map((u) => u.user),
+    cloudtrail_events: events.map((e) => ({
+      name: e.EventName,
+      time: e.EventTime,
+      user: e.Username,
+    })),
+    github_collaborators:
+      collaborators ?? "gh でログインしていないので取得していない",
+  };
+  writeFileSync(
+    join(evidenceDir("access-review"), "report.json"),
+    JSON.stringify(report, null, 2),
+  );
+  const ok = keyHolders.length === 0;
+  opsLog(
+    "access-review",
+    ok,
+    `利用者${users.length}件，アクセスキーを持つ利用者${keyHolders.length}件，古いアクセスキー${staleKeys.length}件`,
+  );
+  if (!ok) {
+    console.error(
+      `アクセスキーを持つ利用者がいる：${keyHolders.map((u) => u.user).join(", ")}`,
+    );
+    process.exit(1);
+  }
+} catch (error) {
+  opsLog("access-review", false, String(error));
+  process.exit(1);
+}
