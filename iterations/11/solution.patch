diff --git a/.github/workflows/access.yml b/.github/workflows/access.yml
new file mode 100644
index 0000000..e1f58fa
--- /dev/null
+++ b/.github/workflows/access.yml
@@ -0,0 +1,80 @@
+name: access
+
+# 権限の棚卸しの報告と，データベースのパスワードの交換．
+# standards.yaml の access.review_interval_days(30日)と credentials.max_age_days(90日)より短い間隔で動かす．
+# この題材では，環境はジョブの中で起動したMiniStackの上に作る．
+on:
+  schedule:
+    - cron: "43 0 1 * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  access-review:
+    runs-on: ubuntu-latest
+    services:
+      ministack:
+        image: ministackorg/ministack:1.5.21@sha256:7a30ff0670578e10528b5a9a21e795ef494f96bbc35691c9b0742ea35de71808
+        ports:
+          - 4566:4566
+        env:
+          CLOUDTRAIL_RECORDING: "1"
+        volumes:
+          - /var/run/docker.sock:/var/run/docker.sock
+        options: --workdir /opt/ministack
+    env:
+      AWS_ENDPOINT_URL: http://localhost:4566
+      AWS_ACCESS_KEY_ID: test
+      AWS_SECRET_ACCESS_KEY: test
+      AWS_REGION: ap-northeast-1
+      AWS_CONFIG_FILE: ${{ github.workspace }}/.devcontainer/aws-config
+      LOG_GROUP_PREFIX: /app/
+      GH_TOKEN: ${{ github.token }}
+    defaults:
+      run:
+        working-directory: app
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+      - run: echo "127.0.0.1 000000000000.localhost" | sudo tee -a /etc/hosts
+      - uses: jdx/mise-action@5228313ee0372e111a38da051671ca30fc5a96db # v3.6.3
+      - run: mise run up
+      - run: mise run ops:access-review
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: always()
+        with:
+          name: evidence-access-review
+          path: app/out/evidence/
+
+  rotate-db-password:
+    runs-on: ubuntu-latest
+    services:
+      ministack:
+        image: ministackorg/ministack:1.5.21@sha256:7a30ff0670578e10528b5a9a21e795ef494f96bbc35691c9b0742ea35de71808
+        ports:
+          - 4566:4566
+        volumes:
+          - /var/run/docker.sock:/var/run/docker.sock
+        options: --workdir /opt/ministack
+    env:
+      AWS_ENDPOINT_URL: http://localhost:4566
+      AWS_ACCESS_KEY_ID: test
+      AWS_SECRET_ACCESS_KEY: test
+      AWS_REGION: ap-northeast-1
+      AWS_CONFIG_FILE: ${{ github.workspace }}/.devcontainer/aws-config
+      LOG_GROUP_PREFIX: /app/
+    defaults:
+      run:
+        working-directory: app
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+      - run: echo "127.0.0.1 000000000000.localhost" | sudo tee -a /etc/hosts
+      - uses: jdx/mise-action@5228313ee0372e111a38da051671ca30fc5a96db # v3.6.3
+      - run: mise run up
+      - run: mise run ops:rotate-db-password
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: always()
+        with:
+          name: evidence-rotate-db-password
+          path: app/out/evidence/
