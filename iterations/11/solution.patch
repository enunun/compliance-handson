+++ b/app/tools/ops/db.ts
@@ -0,0 +1,40 @@
+// データベースの接続先と認証情報を，Secrets Managerのシークレットから得る．
+// パスワードの正はシークレットだけにあるので，交換した後も古くならない．
+import { sh, tofuOutput } from "./run.ts";
+
+export type DbSecret = {
+  username: string;
+  password: string;
+  host: string;
+  port: number;
+  dbname: string;
+};
+
+export function readDbSecret(secretId = tofuOutput("db_secret_id")): DbSecret {
+  return JSON.parse(
+    sh("aws", [
+      "secretsmanager",
+      "get-secret-value",
+      "--secret-id",
+      secretId,
+      "--query",
+      "SecretString",
+      "--output",
+      "text",
+    ]),
+  );
+}
+
+export function toUrl(s: DbSecret): string {
+  return `postgres://${s.username}:${encodeURIComponent(s.password)}@${s.host}:${s.port}/${s.dbname}`;
+}
+
+/** データベースの接続先のURL． */
+export function databaseUrl(): string {
+  return toUrl(readDbSecret());
+}
+
+// コマンドとして実行すると，接続先のURLを表示する(mise run dev:api が使う)．
+if (import.meta.main) {
+  console.log(databaseUrl());
+}
diff --git a/app/tools/ops/rotate-db-password.ts b/app/tools/ops/rotate-db-password.ts
new file mode 100644
index 0000000..7c57220
--- /dev/null
+++ b/app/tools/ops/rotate-db-password.ts
@@ -0,0 +1,49 @@
+// データベースのパスワードを交換する．
+// 新しいパスワードをデータベースに設定し，シークレットを更新し，新しいパスワードで接続できることを確かめる．
+import { randomBytes } from "node:crypto";
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { readDbSecret, toUrl } from "./db.ts";
+import { evidenceDir, opsLog, sh, tofuOutput } from "./run.ts";
+
+try {
+  const secretId = tofuOutput("db_secret_id");
+  const current = readDbSecret(secretId);
+  const next = { ...current, password: randomBytes(24).toString("hex") };
+
+  // 新しいパスワードを，今のパスワードで接続して設定する．
+  sh("psql", [
+    toUrl(current),
+    "-v",
+    "ON_ERROR_STOP=1",
+    "-c",
+    `ALTER ROLE "${current.username}" PASSWORD '${next.password}'`,
+  ]);
+  sh("aws", [
+    "secretsmanager",
+    "put-secret-value",
+    "--secret-id",
+    secretId,
+    "--secret-string",
+    JSON.stringify(next),
+  ]);
+  sh("psql", [toUrl(next), "-tAc", "SELECT 1"]);
+
+  const result = {
+    time: new Date().toISOString(),
+    secret: secretId,
+    user: current.username,
+  };
+  writeFileSync(
+    join(evidenceDir("rotate-db-password"), "result.json"),
+    JSON.stringify(result, null, 2),
+  );
+  opsLog(
+    "rotate-db-password",
+    true,
+    `${secretId} の ${current.username} のパスワードを交換した`,
+  );
+} catch (error) {
+  opsLog("rotate-db-password", false, String(error));
+  process.exit(1);
+}
