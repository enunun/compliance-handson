+import { describe, expect, it } from "vitest";
+import { fixture, run } from "./helpers.ts";
+
+/** fixtures/iam/<name> のOpenTofuのコードとポリシーを検査する． */
+function iam(name: string) {
+  return run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/gates/iam.ts",
+    "--infra",
+    fixture("iam", name),
+  ]);
+}
+
+describe("gate:iam", () => {
+  it("ポリシーをコードの中に書いていれば失敗する", () => {
+    const result = iam("inline");
+    expect(result.output).toContain("ポリシーをコードの中に書いている");
+    expect(result.status).toBe(1);
+  });
+
+  it("長期のアクセスキーを作っていれば失敗する", () => {
+    const result = iam("access-key");
+    expect(result.output).toContain(
+      "長期のアクセスキー(aws_iam_access_key)を作っている",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("すべての操作やすべての対象を許すポリシーがあれば失敗する", () => {
+    const result = iam("wildcard");
+    expect(result.output).toContain("操作 s3:* はすべての操作を許す");
+    expect(result.output).toContain("対象 * はすべての対象を許す");
+    expect(result.status).toBe(1);
+  });
+
+  it("OIDCの信頼ポリシーがリポジトリとブランチを絞っていなければ失敗する", () => {
+    const result = iam("loose-trust");
+    expect(result.output).toContain(
+      "OIDCの aud を sts.amazonaws.com に絞っていない",
+    );
+    expect(result.output).toContain(
+      "OIDCの sub を1つのリポジトリのブランチか環境に絞っていない(repo:example/*)",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("権限を絞ったポリシーだけなら通る", () => {
+    const result = iam("good");
+    expect(result.output).toContain("no problems");
+    expect(result.status).toBe(0);
+  });
+});
