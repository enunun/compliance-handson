+describe("answer", () => {
+  it("質問の要求に合う運用項目があれば「はい」と答え，その項目を示す", () => {
+    const [a] = answer(
+      [
+        {
+          id: "Q1",
+          text: "脆弱性を管理していますか",
+          requirements: ["ISO27001:A.8.8"],
+        },
+      ],
+      items,
+    );
+    expect(a.answer).toBe("はい");
+    expect(a.items.map((i) => i.id)).toEqual(["sca", "triage"]);
+  });
+
+  it("合う運用項目がなければ「要確認」と答える", () => {
+    const [a] = answer(
+      [
