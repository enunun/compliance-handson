+// セキュリティチェックシートの回答の下書きを作る．
+// 質問の要求(requirements)と運用項目の要求を突き合わせ，答えに使える運用項目と証跡を示す．
+// 使い方：mise run ops:checksheet <チェックシートのYAML>
+import { mkdirSync, writeFileSync } from "node:fs";
+import { basename, extname, join } from "node:path";
+import { parseArgs } from "node:util";
+import { type Item, type ItemsFile, readYaml } from "./items.ts";
+
+/** チェックシートの質問．requirements には，その質問が問う規格の要求を書く． */
+export type Question = { id: string; text: string; requirements: string[] };
+
+export type Answer = {
+  question: Question;
+  answer: "はい" | "要確認";
+  items: Item[];
+};
+
+/** 質問ごとに，要求が1つでも重なる運用項目を探して答える． */
+export function answer(questions: Question[], items: Item[]): Answer[] {
+  return questions.map((question) => {
+    const matched = items.filter((item) =>
+      item.requirements.some((r) => question.requirements.includes(r)),
+    );
+    return {
+      question,
+      answer: matched.length > 0 ? "はい" : "要確認",
+      items: matched,
+    };
+  });
+}
+
+/** 回答の下書きをMarkdownにする． */
+export function renderChecksheet(title: string, answers: Answer[]): string {
+  const lines = [
+    `# ${title} の回答の下書き`,
+    "",
+    "mise run ops:checksheet で生成した．回答する前に，人が内容を確かめる．",
+    "",
+  ];
+  for (const { question, answer, items } of answers) {
+    lines.push(`## ${question.id} ${question.text}`, "", `回答：${answer}`, "");
+    if (items.length === 0) {
+      lines.push(
+        `対応する運用項目がない(要求：${question.requirements.join("，")})．`,
+        "",
+      );
+      continue;
+    }
+    lines.push(
+      "| 運用項目 | 仕組みが動いた証跡 | 手順書 |",
+      "| --- | --- | --- |",
+    );
+    for (const item of items) {
+      lines.push(
+        `| ${item.id}(${item.title}) | ${item.evidence} | ${item.runbook ?? ""} |`,
+      );
+    }
+    lines.push("");
+  }
+  return lines.join("\n");
+}
+
+if (import.meta.main) {
+  const { values, positionals } = parseArgs({
+    allowPositionals: true,
+    options: {
+      ops: { type: "string", default: "ops" },
+    },
+  });
+  const [file] = positionals;
+  if (!file) {
+    console.error("チェックシートのYAMLを指定する");
+    process.exit(1);
+  }
+  const sheet = readYaml(file) as { title: string; questions: Question[] };
+  const { items } = readYaml(join(values.ops, "items.yaml")) as ItemsFile;
+  const answers = answer(sheet.questions, items);
+  for (const { question, answer, items } of answers) {
+    console.log(`${question.id} ${question.text} → ${answer}`);
+    if (items.length > 0) {
+      console.log(`    運用項目: ${items.map((i) => i.id).join(", ")}`);
+    }
+  }
+  mkdirSync("out", { recursive: true });
+  const out = join("out", `checksheet-${basename(file, extname(file))}.md`);
+  writeFileSync(out, renderChecksheet(sheet.title, answers));
+  console.log(`wrote ${out}`);
+}
