+  title: id,
+  category: "基盤運用",
+  requirements,
+  mechanisms: [{ workflow: "gates.yml", job: id }],
+  evidence: `${id}の結果`,
+  timing: "定常(変更ごと)",
+  actor: "自動",
+});
+
+const items = [
+  item("sca", ["ISO27001:A.8.8", "SOC2:CC7.1"]),
+  item("triage", ["ISO27001:A.8.8"]),
+  item("backup", ["ISO27001:A.8.13"]),
+];
