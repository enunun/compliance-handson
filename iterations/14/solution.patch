new file mode 100644
index 0000000..123dc77
--- /dev/null
+++ b/app/tools/ops/report.ts
@@ -0,0 +1,189 @@
+// 月次報告を作る．
+// 運用項目ごとに，その月に仕組みが動いた証跡があるかを確かめ，脆弱性と例外の状況とまとめる．
+// 証跡は，records の match で絞ったログ(CloudWatch Logs)と，gates.yml のジョブが証跡の保管場所に残したものを探す．
+// 使い方：mise run ops:report --month YYYY-MM
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+import { checkSla } from "../gates/sla.ts";
+import { type Item, type ItemsFile, readYaml } from "./items.ts";
+import { sh, tofuOutput } from "./run.ts";
+import { readExceptions, readStandards } from "./standards.ts";
+
+/** 証跡を探す場所．ログの記録か，証跡の保管場所のゲートの結果である． */
+export type Source =
+  | { log: string; match: Record<string, string | number> }
+  | { gate: string };
+
+/** 運用項目の証跡を探す場所を返す．探す場所がなければ空である． */
+export function sourcesOf(item: Item): Source[] {
+  return [
+    ...(item.records ?? []).flatMap((r) =>
+      r.match ? [{ log: r.log, match: r.match }] : [],
+    ),
+    ...item.mechanisms.flatMap((m) =>
+      "workflow" in m && m.workflow === "gates.yml" ? [{ gate: m.job }] : [],
+    ),
+  ];
+}
+
+/** 定常の運用項目か．非定常だけの項目は，記録がなくても欠けたとしない． */
+export function isRegular(item: Item): boolean {
+  return /(^|[^非])定常/.test(item.timing);
+}
+
+function describe(source: Source): string {
+  if ("gate" in source) {
+    return `証跡の ${source.gate}/`;
+  }
+  const match = Object.entries(source.match)
+    .map(([k, v]) => `${k}=${v}`)
+    .join(",");
+  return `${source.log} のログ(${match})`;
+}
+
+/** その月の証跡の保管場所にある，ゲートの名前(<日付>/<コミット>/<ゲート>/)の一覧． */
+function gatesWithEvidence(bucket: string, month: string): Set<string> {
+  const keys = JSON.parse(
+    sh("aws", [
+      "s3api",
+      "list-objects-v2",
+      "--bucket",
+      bucket,
+      "--prefix",
+      `${month}-`,
+      "--query",
+      "Contents[].Key",
+      "--output",
+      "json",
+    ]) || "null",
+  ) as string[] | null;
+  return new Set((keys ?? []).map((k) => k.split("/")[2]));
+}
+
+/** その月の，match に合うログの記録の数． */
+function countLogs(
+  source: { log: string; match: Record<string, string | number> },
+  start: number,
+  end: number,
+): number {
+  const prefix = process.env.LOG_GROUP_PREFIX ?? "/app/";
+  const pattern = Object.entries(source.match)
+    .map(([k, v]) => `$.${k} = ${JSON.stringify(v)}`)
+    .join(" && ");
+  const result = JSON.parse(
+    sh("aws", [
+      "logs",
+      "filter-log-events",
+      "--log-group-name",
+      `${prefix}${source.log}`,
+      "--start-time",
+      String(start),
+      "--end-time",
+      String(end),
+      "--filter-pattern",
+      `{ ${pattern} }`,
+      "--output",
+      "json",
+    ]),
+  ) as { events: unknown[] };
+  return result.events.length;
+}
+
+if (import.meta.main) {
+  const today = new Date().toISOString().slice(0, 10);
+  const { values } = parseArgs({
+    options: {
+      month: { type: "string", default: today.slice(0, 7) },
+      today: { type: "string", default: today },
+      ops: { type: "string", default: "ops" },
+      exceptions: { type: "string", default: "ops/exceptions.yaml" },
+      scorecard: {
+        type: "string",
+        default: "out/evidence/scorecard/results.json",
+      },
+    },
+  });
+  const month = values.month;
+  const start = Date.parse(`${month}-01T00:00:00Z`);
+  const next = new Date(start);
+  next.setUTCMonth(next.getUTCMonth() + 1);
+  const end = next.getTime();
+
+  const { items } = readYaml(join(values.ops, "items.yaml")) as ItemsFile;
+  const gates = gatesWithEvidence(tofuOutput("evidence_bucket"), month);
+  const rows = items.map((item) => {
+    const sources = sourcesOf(item);
+    const found = sources.every((s) =>
+      "gate" in s ? gates.has(s.gate) : countLogs(s, start, end) > 0,
+    );
+    let result = "対象外";
+    if (sources.length > 0) {
+      result = found ? "あり" : isRegular(item) ? "なし" : "該当なし";
+    }
+    return { item, sources, result };
+  });
+  const checked = rows.filter((r) => r.sources.length > 0);
+  const missing = rows.filter((r) => r.result === "なし");
+
+  const exceptions = readExceptions(values.exceptions);
+  const sla = checkSla(
+    exceptions,
+    readStandards(values.ops).vulnerability.sla_days,
+    values.today,
+  );
+  const soon = new Date(Date.parse(values.today) + 30 * 24 * 60 * 60 * 1000)
+    .toISOString()
+    .slice(0, 10);
+  const expiring = exceptions.filter(
+    (e) => e.expires >= values.today && e.expires <= soon,
+  );
+  const scorecard = existsSync(values.scorecard)
+    ? String(JSON.parse(readFileSync(values.scorecard, "utf8")).score)
+    : "未取得";
+
+  const lines = [
+    `# 月次報告 ${month}`,
+    "",
+    `mise run ops:report で ${values.today} に生成した．`,
+    "",
+    "## 運用項目ごとの証跡",
+    "",
+    "「なし」は，定常の運用項目でその月の証跡が見つからなかったことを示す．",
+    "「該当なし」は，非定常の運用項目で，その月に行う機会がなかったことを示す．",
+    "「対象外」は，証跡を自動で探さない運用項目である(仕組みの結果や変更履歴で確かめる)．",
+    "",
+    "| 運用項目 | 名前 | 探した証跡 | 結果 |",
+    "| --- | --- | --- | --- |",
+    ...rows.map(
+      (r) =>
+        `| ${r.item.id} | ${r.item.title} | ${r.sources.map(describe).join("<br>")} | ${r.result} |`,
+    ),
+    "",
+    "## 脆弱性と例外",
+    "",
+    `- 直す期限を過ぎた脆弱性：${sla.overdue.length}件${sla.overdue.map((o) => ` ${o.exception.id}(${o.exception.target})`).join("")}`,
+    `- 影響がないと判断した脆弱性：${sla.notAffected.length}件`,
+    `- 30日以内に期限の来る例外：${expiring.length}件${expiring.map((e) => ` ${e.id}(${e.expires})`).join("")}`,
+    "",
+    "## OpenSSF Scorecard",
+    "",
+    `点数：${scorecard}`,
+    "",
+  ];
+  mkdirSync("out", { recursive: true });
+  const out = join("out", `report-${month}.md`);
+  writeFileSync(out, lines.join("\n"));
+  console.log(`wrote ${out}`);
+  console.log(
+    `  items: ${items.length} (checked: ${checked.length}, evidence found: ${rows.filter((r) => r.result === "あり").length})`,
+  );
+  console.log(
+    `  missing evidence: ${missing.map((r) => r.item.id).join(", ") || "なし"}`,
+  );
+  console.log(`  vulnerabilities over SLA: ${sla.overdue.length}`);
+  console.log(
+    `  exceptions expiring within 30 days: ${expiring.length}${expiring.map((e) => ` (${e.id})`).join("")}`,
+  );
+  console.log(`  OpenSSF Scorecard: ${scorecard}`);
+}
