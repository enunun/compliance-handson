+import { readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { beforeAll, describe, expect, it } from "vitest";
+import { appRoot, run } from "../gates/helpers.ts";
+
+// 本番の環境(mise run up で作った環境)の証跡から，月次報告を作って確かめる．
+// ほかのテストの証跡と混ざらないよう，2099年1月の日付で証跡を置く．
+const month = "2099-01";
+let report: string;
+let result: ReturnType<typeof run>;
+
+beforeAll(() => {
+  const bucket = run("tofu", [
+    "-chdir=infra",
+    "output",
+    "-raw",
+    "evidence_bucket",
+  ]).output.trim();
+  const file = join(tmpdir(), "trivy.json");
+  writeFileSync(file, "{}");
+  run("aws", [
+    "s3",
+    "cp",
+    file,
+    `s3://${bucket}/${month}-15/test/sca/trivy.json`,
+  ]);
+  result = run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/ops/report.ts",
+    "--month",
+    month,
+  ]);
+  report = readFileSync(join(appRoot, `out/report-${month}.md`), "utf8");
+}, 120_000);
+
+describe("月次報告", () => {
+  it("その月の証跡が見つかった運用項目を示す", () => {
+    expect(result.status, result.output).toBe(0);
+    expect(report).toMatch(/\| dependency-vulnerabilities \|.*\| あり \|/);
+  });
+
+  it("定常の運用項目で証跡が欠けていれば，それを示す", () => {
+    expect(report).toMatch(/\| actions-pinning \|.*\| なし \|/);
+    expect(result.output).toContain("actions-pinning");
+  });
+
+  it("非定常の運用項目は，記録がなくても欠けたとしない", () => {
+    expect(report).toMatch(/\| deploy-verification \|.*\| 該当なし \|/);
+  });
+});
