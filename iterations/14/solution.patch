+// ゲートの証跡に共通の処理．
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+
+/** ゲートの証跡の置き場所．ゲートのテストでは EVIDENCE_DIR で一時的な場所に替える． */
+export function evidenceDirOf(gate: string): string {
+  const dir = join(process.env.EVIDENCE_DIR ?? "out/evidence", gate);
+  mkdirSync(dir, { recursive: true });
+  return dir;
+}
+
+/** ゲートの結果(見つかった問題と，調べた対象など)を，証跡の <ゲート>/result.json に残す． */
+export function writeResult(
+  gate: string,
+  result: { problems: string[] } & Record<string, unknown>,
+): void {
+  writeFileSync(
+    join(evidenceDirOf(gate), "result.json"),
+    `${JSON.stringify(result, null, 2)}\n`,
+  );
+}
