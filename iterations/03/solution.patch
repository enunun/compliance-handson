+import { readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { beforeAll, describe, expect, it } from "vitest";
+import { parse } from "yaml";
+import { appRoot, run } from "../gates/helpers.ts";
+
+// 本番の環境(mise run up で作ったMiniStackの上の環境)の，証跡の保管場所を確かめる．
+let bucket: string;
+
+function aws(...args: string[]) {
+  return run("aws", ["s3api", ...args]);
+}
+
+beforeAll(() => {
+  bucket = run("tofu", [
+    "-chdir=infra",
+    "output",
+    "-raw",
+    "evidence_bucket",
+  ]).output.trim();
+});
+
+describe("証跡の保管場所", () => {
+  it("基準値の日数だけ，消せない状態で保管する", () => {
+    const standards = parse(
+      readFileSync(join(appRoot, "ops/standards.yaml"), "utf8"),
+    );
+    const result = aws("get-object-lock-configuration", "--bucket", bucket);
+    const rule = JSON.parse(result.output).ObjectLockConfiguration.Rule;
+    expect(rule.DefaultRetention).toEqual({
+      Mode: "COMPLIANCE",
+      Days: standards.evidence.retention_days,
+    });
+  });
+
+  it("保管した証跡は，版を指定しても消せない", () => {
+    const file = join(tmpdir(), "evidence-test.json");
+    writeFileSync(file, "{}");
+    const put = JSON.parse(
+      aws(
+        "put-object",
+        "--bucket",
+        bucket,
+        "--key",
+        "test/evidence-test.json",
+        "--body",
+        file,
+      ).output,
+    );
+    const deletion = aws(
+      "delete-object",
+      "--bucket",
+      bucket,
+      "--key",
+      "test/evidence-test.json",
+      "--version-id",
+      put.VersionId,
+    );
+    expect(deletion.output).toContain("AccessDenied");
+    expect(deletion.status).not.toBe(0);
+  });
+});
diff --git a/app/tools/gates/license.ts b/app/tools/gates/license.ts
new file mode 100644
index 0000000..54b3989
--- /dev/null
+++ b/app/tools/gates/license.ts
@@ -0,0 +1,68 @@
+// SBOM(CycloneDX)の依存関係のライセンスが，基準値で許可したものかを検査する．
+import { readFileSync } from "node:fs";
+import { parseArgs } from "node:util";
+import { readStandards } from "../ops/standards.ts";
+
+type Component = {
+  type: string;
+  name: string;
+  version?: string;
+  licenses?: {
+    license?: { id?: string; name?: string };
+    expression?: string;
+  }[];
+};
+
+/** 部品のライセンスを，SPDXの識別子か式の配列で返す． */
+function licensesOf(component: Component): string[] {
+  return (component.licenses ?? []).flatMap((l) => {
+    const value = l.license?.id ?? l.license?.name ?? l.expression;
+    return value ? [value] : [];
+  });
+}
+
+/** 許可されないライセンスの部品を返す．ライセンスが分からない部品も返す． */
+export function checkLicenses(
+  components: Component[],
+  allowed: string[],
+): string[] {
+  return (
+    components
+      // ロックファイルや自分たちのモジュールは，版を持たないので外す．
+      .filter((c) => c.type !== "application" && c.version)
+      .flatMap((c) => {
+        const licenses = licensesOf(c);
+        const name = `${c.name}@${c.version}`;
+        if (licenses.length === 0) {
+          return [`${name}: ライセンスが分からない`];
+        }
+        const denied = licenses.filter((l) => !allowed.includes(l));
+        return denied.length > 0
+          ? [`${name}: ${denied.join(", ")} は許可されていない`]
+          : [];
+      })
+  );
+}
+
+if (import.meta.main) {
+  const { values, positionals } = parseArgs({
+    options: { ops: { type: "string", default: "ops" } },
+    allowPositionals: true,
+  });
+  const allowed = readStandards(values.ops).license.allowed;
+  const problems = positionals.flatMap((file) => {
+    const sbom = JSON.parse(readFileSync(file, "utf8")) as {
+      components?: Component[];
+    };
+    return checkLicenses(sbom.components ?? [], allowed).map(
+      (p) => `${file}: ${p}`,
+    );
+  });
+  for (const problem of problems) {
+    console.error(problem);
+  }
+  if (problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(`license: ${positionals.length} SBOMs, all allowed`);
+}
