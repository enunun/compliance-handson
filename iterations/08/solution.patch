@@ -0,0 +1,56 @@
+package logging_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log/slog"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/service/cloudwatchlogs"
+
+	"github.com/enunun/compliance-handson/app/apps/api/internal/logging"
+)
+
+// fakeClient は，送られたログをロググループごとに覚える．
+type fakeClient struct {
+	events map[string][]string
+}
+
+func (f *fakeClient) CreateLogStream(context.Context, *cloudwatchlogs.CreateLogStreamInput, ...func(*cloudwatchlogs.Options)) (*cloudwatchlogs.CreateLogStreamOutput, error) {
+	return &cloudwatchlogs.CreateLogStreamOutput{}, nil
+}
+
+func (f *fakeClient) PutLogEvents(_ context.Context, in *cloudwatchlogs.PutLogEventsInput, _ ...func(*cloudwatchlogs.Options)) (*cloudwatchlogs.PutLogEventsOutput, error) {
+	for _, e := range in.LogEvents {
+		f.events[*in.LogGroupName] = append(f.events[*in.LogGroupName], *e.Message)
+	}
+	return &cloudwatchlogs.PutLogEventsOutput{}, nil
+}
+
+func TestSendsEachLogTypeToItsGroup(t *testing.T) {
+	var stdout bytes.Buffer
+	client := &fakeClient{events: map[string][]string{}}
+	logger := slog.New(logging.NewCloudWatchHandler(slog.NewJSONHandler(&stdout, nil), client, "/app/", "test"))
+
+	logger.Info("request handled", "log_type", "api", "request_id", "r1")
+	logger.Info("login.failed", "log_type", "audit", "request_id", "r2")
+	logger.Info("started")
+
+	if got := len(client.events["/app/api"]); got != 1 {
+		t.Fatalf("/app/api events = %d", got)
+	}
+	var line map[string]any
+	if err := json.Unmarshal([]byte(client.events["/app/audit"][0]), &line); err != nil {
+		t.Fatal(err)
+	}
+	if line["request_id"] != "r2" || line["msg"] != "login.failed" {
+		t.Fatalf("audit line = %v", line)
+	}
+	if len(client.events) != 2 {
+		t.Fatalf("log without log_type was sent: %v", client.events)
+	}
+	if bytes.Count(stdout.Bytes(), []byte("\n")) != 3 {
+		t.Fatalf("stdout = %s", stdout.String())
+	}
+}
diff --git a/app/apps/api/internal/server/logging.go b/app/apps/api/internal/server/logging.go
new file mode 100644
index 0000000..908e02b
--- /dev/null
+++ b/app/apps/api/internal/server/logging.go
@@ -0,0 +1,87 @@
+package server
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"log/slog"
+	"net"
+	"net/http"
+	"time"
+
+	"github.com/enunun/compliance-handson/app/apps/api/internal/store"
+)
+
+// ログの種類と項目は，app/ops/logs.yaml の設計に従う．
+
+type requestIDKey struct{}
+
+// withRequestLog は，リクエストに識別子を付け，処理の終わりに api のログを1行記録する．
+func withRequestLog(logger *slog.Logger, route string, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		start := time.Now()
+		id := r.Header.Get("X-Request-Id")
+		if id == "" {
+			id = newRequestID()
+		}
+		w.Header().Set("X-Request-Id", id)
+		rec := &statusRecorder{ResponseWriter: w, code: http.StatusOK}
+		next.ServeHTTP(rec, r.WithContext(context.WithValue(r.Context(), requestIDKey{}, id)))
+
+		level := slog.LevelInfo
+		if rec.code >= 500 {
+			level = slog.LevelError
+		}
+		logger.LogAttrs(r.Context(), level, "request handled",
+			slog.String("log_type", "api"),
+			slog.String("request_id", id),
+			slog.String("method", r.Method),
+			slog.String("route", route),
+			slog.Int("status", rec.code),
+			slog.Float64("duration_ms", float64(time.Since(start).Microseconds())/1000),
+		)
+	})
+}
+
+// logError は，処理の途中のエラーを api のログに記録する．
+func logError(logger *slog.Logger, r *http.Request, msg string, err error) {
+	logger.LogAttrs(r.Context(), slog.LevelError, msg,
+		slog.String("log_type", "api"),
+		slog.String("request_id", requestID(r)),
+		slog.String("error", err.Error()),
+	)
+}
+
+// audit は，誰が何をしたかを audit のログに記録する．
+func audit(logger *slog.Logger, r *http.Request, action string, succeeded bool, attrs ...slog.Attr) {
+	result := "succeeded"
+	if !succeeded {
+		result = "failed"
+	}
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil {
+		host = r.RemoteAddr
+	}
+	logger.LogAttrs(r.Context(), slog.LevelInfo, action, append([]slog.Attr{
+		slog.String("log_type", "audit"),
+		slog.String("request_id", requestID(r)),
+		slog.String("action", action),
+		slog.String("result", result),
+		slog.String("source_ip", host),
+	}, attrs...)...)
+}
+
+func actorAttr(u store.User) slog.Attr {
+	return slog.Int64("actor_id", u.ID)
+}
+
+func requestID(r *http.Request) string {
+	id, _ := r.Context().Value(requestIDKey{}).(string)
+	return id
+}
+
+func newRequestID() string {
+	b := make([]byte, 8)
+	_, _ = rand.Read(b)
+	return hex.EncodeToString(b)
+}
