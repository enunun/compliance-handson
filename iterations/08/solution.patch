diff --git a/app/apps/api/internal/logging/cloudwatch.go b/app/apps/api/internal/logging/cloudwatch.go
new file mode 100644
index 0000000..6292aa1
--- /dev/null
+++ b/app/apps/api/internal/logging/cloudwatch.go
@@ -0,0 +1,118 @@
+// Package logging は，構造化ログをCloudWatch Logsにも送る．
+package logging
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"log/slog"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/cloudwatchlogs"
+	"github.com/aws/aws-sdk-go-v2/service/cloudwatchlogs/types"
+)
+
+// Client は，CloudWatch Logsに書き込む関数の組である．
+type Client interface {
+	CreateLogStream(ctx context.Context, in *cloudwatchlogs.CreateLogStreamInput, opts ...func(*cloudwatchlogs.Options)) (*cloudwatchlogs.CreateLogStreamOutput, error)
+	PutLogEvents(ctx context.Context, in *cloudwatchlogs.PutLogEventsInput, opts ...func(*cloudwatchlogs.Options)) (*cloudwatchlogs.PutLogEventsOutput, error)
+}
+
+// CloudWatchHandler は，ログを next に渡したうえで，log_type の値ごとのロググループ
+// (prefix + log_type)にも送る．log_type のないログは送らない．
+// 1行ごとに送るので，量の多い本番では，ログの転送の仕組み(FireLensなど)に替える．
+type CloudWatchHandler struct {
+	next   slog.Handler
+	attrs  []slog.Attr
+	shared *shared
+}
+
+type shared struct {
+	client  Client
+	prefix  string
+	stream  string
+	mu      sync.Mutex
+	created map[string]bool
+}
+
+// NewCloudWatchHandler は，next にも書くハンドラを作る．stream はログストリームの名前である．
+func NewCloudWatchHandler(next slog.Handler, client Client, prefix, stream string) *CloudWatchHandler {
+	return &CloudWatchHandler{
+		next:   next,
+		shared: &shared{client: client, prefix: prefix, stream: stream, created: map[string]bool{}},
+	}
+}
+
+func (h *CloudWatchHandler) Enabled(ctx context.Context, level slog.Level) bool {
+	return h.next.Enabled(ctx, level)
+}
+
+func (h *CloudWatchHandler) WithAttrs(attrs []slog.Attr) slog.Handler {
+	return &CloudWatchHandler{
+		next:   h.next.WithAttrs(attrs),
+		attrs:  append(append([]slog.Attr{}, h.attrs...), attrs...),
+		shared: h.shared,
+	}
+}
+
+func (h *CloudWatchHandler) WithGroup(name string) slog.Handler {
+	return &CloudWatchHandler{next: h.next.WithGroup(name), attrs: h.attrs, shared: h.shared}
+}
+
+func (h *CloudWatchHandler) Handle(ctx context.Context, r slog.Record) error {
+	err := h.next.Handle(ctx, r)
+	logType := h.logType(r)
+	if logType == "" {
+		return err
+	}
+	// next と同じ形(JSON)の1行を作って送る．
+	var buf bytes.Buffer
+	if e := slog.NewJSONHandler(&buf, nil).WithAttrs(h.attrs).Handle(ctx, r); e != nil {
+		return errors.Join(err, e)
+	}
+	return errors.Join(err, h.shared.put(ctx, h.shared.prefix+logType, strings.TrimSpace(buf.String()), r.Time))
+}
+
+func (h *CloudWatchHandler) logType(r slog.Record) string {
+	var logType string
+	for _, a := range h.attrs {
+		if a.Key == "log_type" {
+			logType = a.Value.String()
+		}
+	}
+	r.Attrs(func(a slog.Attr) bool {
+		if a.Key == "log_type" {
+			logType = a.Value.String()
+		}
+		return true
+	})
+	return logType
+}
+
+func (s *shared) put(ctx context.Context, group, message string, at time.Time) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.created[group] {
+		_, err := s.client.CreateLogStream(ctx, &cloudwatchlogs.CreateLogStreamInput{
+			LogGroupName:  aws.String(group),
+			LogStreamName: aws.String(s.stream),
+		})
+		var exists *types.ResourceAlreadyExistsException
+		if err != nil && !errors.As(err, &exists) {
+			return err
+		}
+		s.created[group] = true
+	}
+	_, err := s.client.PutLogEvents(ctx, &cloudwatchlogs.PutLogEventsInput{
+		LogGroupName:  aws.String(group),
+		LogStreamName: aws.String(s.stream),
+		LogEvents: []types.InputLogEvent{{
+			Message:   aws.String(message),
+			Timestamp: aws.Int64(at.UnixMilli()),
+		}},
+	})
+	return err
+}
