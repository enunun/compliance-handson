@@ -0,0 +1,42 @@
+# yaml-language-server: $schema=./schema/logs.schema.json
+# ログの設計．運用項目の records(ログで答える問い)から導く．
+# 保管期間は standards.yaml の logs.retention_days に書く．
+
+# どのログにも記録してはならない項目．
+forbidden_fields: [password, token, authorization, cookie]
+
+types:
+  api:
+    description: APIのリクエストの処理の記録．障害の調査に使う．
+    destination: CloudWatch Logs の /app/api
+    readers: [開発チーム, オンコールの担当者]
+    fields:
+      time: { type: string, description: 記録した時刻(RFC 3339) }
+      level: { type: string, description: INFO，WARN，ERROR のどれか }
+      msg: { type: string, description: 何が起きたか }
+      log_type: { type: string, description: ログの種類(api) }
+      request_id: { type: string, description: リクエストの識別子．応答の X-Request-Id と同じ }
+      method: { type: string, description: HTTPのメソッド }
+      route: { type: string, description: 登録したルート(例：GET /api/notes) }
+      status: { type: integer, description: 応答のステータスコード }
+      duration_ms: { type: number, description: 処理にかかった時間(ミリ秒) }
+      error: { type: string, description: エラーの内容(エラーのときだけ) }
+    required: [time, level, msg, log_type, request_id]
+
+  audit:
+    description: 誰がいつ何をしたかの記録．監査と不正の調査に使う．
+    destination: CloudWatch Logs の /app/audit
+    readers: [セキュリティ責任者]
+    fields:
+      time: { type: string, description: 記録した時刻(RFC 3339) }
+      level: { type: string, description: INFO，WARN，ERROR のどれか }
+      msg: { type: string, description: 何が起きたか }
+      log_type: { type: string, description: ログの種類(audit) }
+      request_id: { type: string, description: リクエストの識別子 }
+      actor_id: { type: integer, description: 操作した利用者のID(ログインの失敗では0) }
+      actor_email: { type: string, description: ログインに使ったメールアドレス(ログインのときだけ) }
+      action: { type: string, description: login.succeeded，login.failed，user.role_changed のどれか }
+      target_id: { type: integer, description: 操作の対象の利用者のID }
+      result: { type: string, description: succeeded か failed }
+      source_ip: { type: string, description: 操作した端末のIPアドレス }
+    required: [time, level, msg, log_type, request_id, action, result]
