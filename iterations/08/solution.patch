diff --git a/app/tools/ops/logs.ts b/app/tools/ops/logs.ts
new file mode 100644
index 0000000..4372cf8
--- /dev/null
+++ b/app/tools/ops/logs.ts
@@ -0,0 +1,146 @@
+import { join } from "node:path";
+import type { ItemsFile } from "./items.ts";
+import { readYaml } from "./items.ts";
+import type { Standards } from "./standards.ts";
+
+export type LogField = {
+  type: "string" | "integer" | "number";
+  description: string;
+};
+
+export type LogType = {
+  description: string;
+  destination: string;
+  readers: string[];
+  fields: Record<string, LogField>;
+  required: string[];
+};
+
+/** ログの設計．ops/schema/logs.schema.json の形に合う． */
+export type LogsFile = {
+  forbidden_fields: string[];
+  types: Record<string, LogType>;
+};
+
+export function readLogs(opsDir: string): LogsFile {
+  return readYaml(join(opsDir, "logs.yaml")) as LogsFile;
+}
+
+/**
+ * 運用項目の records(ログで答える問い)とログの設計が合っているかを確かめ，問題を返す．
+ * - 問いが使うログの種類と項目が，ログの設計にある．
+ * - ログの種類の保管期間が，その種類を使う問いの keep_days 以上である．
+ * - 記録してはならない項目を，どの種類も持たない．
+ */
+export function checkRecords(
+  items: ItemsFile,
+  logs: LogsFile,
+  standards: Standards,
+): string[] {
+  const problems: string[] = [];
+  const longest: Record<string, number> = {};
+  for (const item of items.items) {
+    for (const record of item.records ?? []) {
+      const type = logs.types[record.log];
+      if (!type) {
+        problems.push(`${item.id}: ログの種類 ${record.log} がない`);
+        continue;
+      }
+      for (const field of record.fields) {
+        if (!(field in type.fields)) {
+          problems.push(
+            `${item.id}: ログの種類 ${record.log} に項目 ${field} がない`,
+          );
+        }
+      }
+      longest[record.log] = Math.max(
+        longest[record.log] ?? 0,
+        record.keep_days,
+      );
+    }
+  }
+  for (const [name, type] of Object.entries(logs.types)) {
+    const retention = standards.logs.retention_days[name];
+    if (retention === undefined) {
+      problems.push(`ログの種類 ${name} の保管期間が standards.yaml にない`);
+    } else if (retention < (longest[name] ?? 0)) {
+      problems.push(
+        `ログの種類 ${name} の保管期間(${retention}日)が，問いの keep_days(${longest[name]}日)より短い`,
+      );
+    }
+    for (const field of logs.forbidden_fields) {
+      if (field in type.fields) {
+        problems.push(
+          `ログの種類 ${name} が，記録してはならない項目 ${field} を持つ`,
+        );
+      }
+    }
+  }
+  return problems;
+}
+
+/** ログの種類の1行を検証するJSON Schemaを作る．設計にない項目は許さない． */
+export function logLineSchema(logs: LogsFile, name: string) {
+  const type = logs.types[name];
+  return {
+    $schema: "https://json-schema.org/draft/2020-12/schema",
+    title: `${name} のログの1行`,
+    type: "object",
+    additionalProperties: false,
+    required: type.required,
+    properties: Object.fromEntries(
+      Object.entries(type.fields).map(([field, { type: t }]) => [
+        field,
+        field === "log_type" ? { const: name } : { type: t },
+      ]),
+    ),
+  };
+}
+
+/** 運用項目とログの対応表のMarkdownを作る． */
+export function renderRecords(
+  items: ItemsFile,
+  logs: LogsFile,
+  standards: Standards,
+): string {
+  const rows = items.items.flatMap((item) =>
+    (item.records ?? []).map((r) =>
+      [
+        item.id,
+        r.question,
+        r.asker,
+        r.within,
+        `${r.keep_days}日`,
+        r.log,
+        r.fields.join(", "),
+      ].join(" | "),
+    ),
+  );
+  const types = Object.entries(logs.types).map(([name, t]) =>
+    [
+      name,
+      t.description,
+      t.destination,
+      t.readers.join("，"),
+      `${standards.logs.retention_days[name]}日`,
+    ].join(" | "),
+  );
+  return [
+    "<!-- このファイルは mise run ops:render で items.yaml，logs.yaml，standards.yaml から生成する．手で編集しない． -->",
+    "",
+    "# 運用項目とログの対応表",
+    "",
+    "## ログで答える問い",
+    "",
+    "| 運用項目 | 問い | 誰が | いつまでに | 遡る期間 | ログ | 項目 |",
+    "| --- | --- | --- | --- | --- | --- | --- |",
+    ...rows.map((row) => `| ${row} |`),
+    "",
+    "## ログの種類",
+    "",
+    "| 種類 | 用途 | 送り先 | 閲覧できる人 | 保管期間 |",
+    "| --- | --- | --- | --- | --- |",
+    ...types.map((row) => `| ${row} |`),
+    "",
+  ].join("\n");
+}
