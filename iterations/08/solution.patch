+func findLog(t *testing.T, lines []map[string]any, logType, msg string) map[string]any {
+	t.Helper()
+	for _, l := range lines {
+		if l["log_type"] == logType && l["msg"] == msg {
+			return l
+		}
+	}
+	t.Fatalf("no %s log %q in %v", logType, msg, lines)
+	return nil
+}
