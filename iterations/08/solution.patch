index 0000000..b0908ad
--- /dev/null
+++ b/app/tests/ops/logs.test.ts
@@ -0,0 +1,135 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { Ajv2020 } from "ajv/dist/2020.js";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { parse } from "yaml";
+import { logLineSchema, readLogs } from "../../tools/ops/logs.ts";
+import { appRoot, run } from "../gates/helpers.ts";
+
+// 本番の環境(mise run up で作った環境)で本物のAPIを動かし，出たログをログの設計と照らし合わせる．
+const port = 18080;
+const base = `http://localhost:${port}`;
+const password = "ops-test-password";
+const logs = readLogs(join(appRoot, "ops"));
+let api: ChildProcess;
+
+async function waitForApi() {
+  for (let i = 0; i < 60; i++) {
+    try {
+      if ((await fetch(`${base}/healthz`)).ok) return;
+    } catch {
+      // 起動を待つ．
+    }
+    await new Promise((r) => setTimeout(r, 1000));
+  }
+  throw new Error("API did not start");
+}
+
+/** ロググループの各行をJSONとして読む． */
+function readGroup(group: string): Record<string, unknown>[] {
+  const result = run("aws", [
+    "logs",
+    "filter-log-events",
+    "--log-group-name",
+    group,
+  ]);
+  return (JSON.parse(result.output).events as { message: string }[]).map((e) =>
+    JSON.parse(e.message),
+  );
+}
+
+beforeAll(async () => {
+  const build = run(
+    "go",
+    ["build", "-o", "../../out/api-ops-test", "./cmd/api"],
+    join(appRoot, "apps/api"),
+  );
+  expect(build.status).toBe(0);
+  const databaseUrl = run("tofu", [
+    "-chdir=infra",
+    "output",
+    "-raw",
+    "database_url",
+  ]).output;
+  api = spawn(join(appRoot, "out/api-ops-test"), [], {
+    env: {
+      ...process.env,
+      DATABASE_URL: databaseUrl,
+      TEST_USER_PASSWORD: password,
+      LOG_GROUP_PREFIX: "/app/",
+      PORT: String(port),
+    },
+    stdio: "ignore",
+  });
+  await waitForApi();
+
+  // 監査ログに残るべき操作をする．
+  const post = (path: string, body: unknown, token?: string, method = "POST") =>
+    fetch(`${base}${path}`, {
+      method,
+      body: JSON.stringify(body),
+      headers: token ? { Authorization: `Bearer ${token}` } : {},
+    });
+  await post("/api/login", {
+    email: "admin@example.com",
+    password: "wrong-password",
+  });
+  const { token } = (await (
+    await post("/api/login", { email: "admin@example.com", password })
+  ).json()) as { token: string };
+  await post("/api/users/2/role", { role: "member" }, token, "PUT");
+}, 120_000);
+
+afterAll(() => {
+  api?.kill();
+});
+
+describe("ログ", () => {
+  for (const name of Object.keys(logs.types)) {
+    it(`${name} のロググループの各行が，ログの設計に合う`, () => {
+      // ログの設計から作ったJSON Schemaで検証する．
+      const validate = new Ajv2020().compile(logLineSchema(logs, name));
+      const lines = readGroup(`/app/${name}`);
+      expect(lines.length).toBeGreaterThan(0);
+      for (const line of lines) {
+        expect(validate(line), JSON.stringify(validate.errors)).toBe(true);
+      }
+    });
+  }
+
+  it("監査ログで，権限の変更とログインの失敗を検索できる", () => {
+    const actions = readGroup("/app/audit").map((l) => l.action);
+    expect(actions).toContain("user.role_changed");
+    expect(actions).toContain("login.failed");
+  });
+
+  it("どのロググループにも，パスワードとトークンを記録しない", () => {
+    for (const name of Object.keys(logs.types)) {
+      const text = JSON.stringify(readGroup(`/app/${name}`));
+      expect(text).not.toContain("wrong-password");
+      expect(text).not.toContain(password);
+    }
+  });
+
+  it("ロググループの保管期間は，基準値と同じである", () => {
+    const standards = parse(
+      readFileSync(join(appRoot, "ops/standards.yaml"), "utf8"),
+    );
+    const result = run("aws", [
+      "logs",
+      "describe-log-groups",
+      "--log-group-name-prefix",
+      "/app/",
+    ]);
+    const groups = JSON.parse(result.output).logGroups as {
+      logGroupName: string;
+      retentionInDays: number;
+    }[];
+    for (const [name, days] of Object.entries(standards.logs.retention_days)) {
+      expect(
+        groups.find((g) => g.logGroupName === `/app/${name}`)?.retentionInDays,
+      ).toBe(days);
+    }
+  });
+});
