diff --git a/app/apps/api/internal/token/token.go b/app/apps/api/internal/token/token.go
new file mode 100644
index 0000000..a5115bf
--- /dev/null
+++ b/app/apps/api/internal/token/token.go
@@ -0,0 +1,18 @@
+// Package token は，外部のファイル配信サービスに渡す署名つきのトークンを作る．
+// トークンを検証するのは配信サービスで，このAPIは署名だけを行う．
+package token
+
+import (
+	"time"
+
+	"github.com/golang-jwt/jwt/v4"
+)
+
+// Sign は，subjectのファイルを ttl の間だけ取得できるトークンを作る．
+func Sign(secret []byte, subject string, ttl time.Duration) (string, error) {
+	claims := jwt.RegisteredClaims{
+		Subject:   subject,
+		ExpiresAt: jwt.NewNumericDate(time.Now().Add(ttl)),
+	}
+	return jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString(secret)
+}
diff --git a/app/apps/api/internal/token/token_test.go b/app/apps/api/internal/token/token_test.go
new file mode 100644
index 0000000..00ca06c
--- /dev/null
+++ b/app/apps/api/internal/token/token_test.go
@@ -0,0 +1,19 @@
+package token_test
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/enunun/compliance-handson/app/apps/api/internal/token"
+)
+
+func TestSignReturnsJWT(t *testing.T) {
+	got, err := token.Sign([]byte("secret"), "notes/1.txt", time.Minute)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Count(got, ".") != 2 {
+		t.Fatalf("not a JWT: %s", got)
+	}
+}
