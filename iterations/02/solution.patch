@@ -0,0 +1,51 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "例外",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["exceptions"],
+  "properties": {
+    "exceptions": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/exception" }
+    }
+  },
+  "$defs": {
+    "exception": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["id", "target", "reason", "approver", "expires"],
+      "properties": {
+        "id": {
+          "description": "例外の識別子(例：EXC-001)",
+          "type": "string",
+          "pattern": "^EXC-[0-9]{3}$"
+        },
+        "target": {
+          "description": "例外にする検出(脆弱性ならCVEなどの識別子)",
+          "type": "string",
+          "minLength": 1
+        },
+        "package": {
+          "description": "対象のパッケージ(分かる場合)",
+          "type": "string"
+        },
+        "reason": {
+          "description": "例外にする理由",
+          "type": "string",
+          "minLength": 1
+        },
+        "approver": {
+          "description": "承認した人(GitHubのアカウント)",
+          "type": "string",
+          "pattern": "^@"
+        },
+        "expires": {
+          "description": "期限(この日を過ぎたら例外は無効)",
+          "type": "string",
+          "format": "date"
+        }
+      }
+    }
+  }
+}
