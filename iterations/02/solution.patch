index 0000000..ed44509
--- /dev/null
+++ b/app/tools/gates/exceptions.ts
@@ -0,0 +1,54 @@
+// 例外の期限を検査する．期限切れの例外と，基準値の最長の日数を超える例外があれば失敗する．
+import { parseArgs } from "node:util";
+import {
+  type Exception,
+  readExceptions,
+  readStandards,
+} from "../ops/standards.ts";
+
+const day = 24 * 60 * 60 * 1000;
+
+/** 例外の期限の問題を返す．today は YYYY-MM-DD である． */
+export function checkExceptions(
+  exceptions: Exception[],
+  maxDays: number,
+  today: string,
+): string[] {
+  const now = Date.parse(today);
+  return exceptions.flatMap((e) => {
+    const days = (Date.parse(e.expires) - now) / day;
+    if (days < 0) {
+      return [`${e.id}: 期限(${e.expires})を過ぎている`];
+    }
+    if (days > maxDays) {
+      return [`${e.id}: 期限(${e.expires})が基準値の${maxDays}日を超えている`];
+    }
+    return [];
+  });
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      ops: { type: "string", default: "ops" },
+      exceptions: { type: "string", default: "ops/exceptions.yaml" },
+      today: {
+        type: "string",
+        default: new Date().toISOString().slice(0, 10),
+      },
+    },
+  });
+  const exceptions = readExceptions(values.exceptions);
+  const problems = checkExceptions(
+    exceptions,
+    readStandards(values.ops).exception.max_days,
+    values.today,
+  );
+  for (const problem of problems) {
+    console.error(problem);
+  }
+  if (problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(`exceptions: ${exceptions.length} active, 0 expired`);
+}
diff --git a/app/tools/gates/sca.ts b/app/tools/gates/sca.ts
new file mode 100644
index 0000000..50fdd56
--- /dev/null
+++ b/app/tools/gates/sca.ts
@@ -0,0 +1,77 @@
+// 依存関係の既知の脆弱性を，Trivyで検査する．
+// 基準値の重大度以上の脆弱性があれば失敗する．例外に載った脆弱性は，期限まで外す．
+import { spawnSync } from "node:child_process";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+import { stringify } from "yaml";
+import {
+  type Exception,
+  readExceptions,
+  readStandards,
+  severitiesFrom,
+} from "../ops/standards.ts";
+
+// 証跡の置き場所．ゲートのテストでは EVIDENCE_DIR で一時的な場所に替える．
+const evidenceDir = join(process.env.EVIDENCE_DIR ?? "out/evidence", "sca");
+// 例外から作るTrivyの除外の設定．どの例外を適用したかの記録として証跡に含める．
+const ignoreFile = join(evidenceDir, "trivyignore.yaml");
+
+/** 例外を，Trivyの除外の設定(.trivyignore.yaml の形)に変える． */
+export function toTrivyIgnore(exceptions: Exception[]) {
+  return {
+    vulnerabilities: exceptions.map((e) => ({
+      id: e.target,
+      statement: `${e.id}: ${e.reason} (承認：${e.approver})`,
+      expired_at: e.expires,
+    })),
+  };
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      target: { type: "string", default: "." },
+      ops: { type: "string", default: "ops" },
+      exceptions: { type: "string", default: "ops/exceptions.yaml" },
+    },
+  });
+  const standards = readStandards(values.ops);
+  const severity = severitiesFrom(standards.vulnerability.fail_severity);
+
+  mkdirSync(evidenceDir, { recursive: true });
+  writeFileSync(
+    ignoreFile,
+    stringify(toTrivyIgnore(readExceptions(values.exceptions))),
+  );
+
+  const report = join(evidenceDir, "trivy.json");
+  const scan = spawnSync(
+    "trivy",
+    [
+      "fs",
+      "--scanners",
+      "vuln",
+      "--severity",
+      severity.join(","),
+      "--ignorefile",
+      ignoreFile,
+      "--skip-dirs",
+      "**/node_modules,tests/gates/fixtures",
+      "--exit-code",
+      "1",
+      "--quiet",
+      "--format",
+      "json",
+      "--output",
+      report,
+      values.target,
+    ],
+    { stdio: "inherit" },
+  );
+  // 人が読む表も出す．証跡はJSONの方である．
+  spawnSync("trivy", ["convert", "--quiet", "--format", "table", report], {
+    stdio: "inherit",
+  });
+  process.exit(scan.status ?? 1);
+}
diff --git a/app/tools/ops/standards.ts b/app/tools/ops/standards.ts
new file mode 100644
index 0000000..b403ed0
--- /dev/null
+++ b/app/tools/ops/standards.ts
@@ -0,0 +1,35 @@
+import { join } from "node:path";
+import { readYaml } from "./items.ts";
+
+export const severities = ["LOW", "MEDIUM", "HIGH", "CRITICAL"] as const;
+export type Severity = (typeof severities)[number];
+
+/** 基準値．ops/schema/standards.schema.json の形に合う． */
+export type Standards = {
+  change: { required_approvals: number };
+  vulnerability: { fail_severity: Severity };
+  exception: { max_days: number };
+};
+
+/** 例外．ops/schema/exceptions.schema.json の形に合う． */
+export type Exception = {
+  id: string;
+  target: string;
+  package?: string;
+  reason: string;
+  approver: string;
+  expires: string;
+};
+
+export function readStandards(opsDir: string): Standards {
+  return readYaml(join(opsDir, "standards.yaml")) as Standards;
+}
+
+export function readExceptions(path: string): Exception[] {
+  return (readYaml(path) as { exceptions: Exception[] }).exceptions;
+}
+
+/** fail_severity 以上の重大度を返す． */
+export function severitiesFrom(failSeverity: Severity): Severity[] {
+  return severities.slice(severities.indexOf(failSeverity));
+}
