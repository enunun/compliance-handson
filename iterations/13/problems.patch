diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
new file mode 100644
index 0000000..c1b3c33
--- /dev/null
+++ b/.github/workflows/deploy.yml
@@ -0,0 +1,41 @@
+name: deploy
+
+# リリース済みのイメージを，本番のECSのサービスにデプロイする．画面から手で動かす．
+on:
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: デプロイするリリースのタグ(例：v1.2.0)
+        required: true
+
+permissions:
+  contents: read
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    environment: production
+    permissions:
+      contents: read
+      id-token: write # OIDCでAWSのロールを引き受ける
+    defaults:
+      run:
+        working-directory: app
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+      - uses: jdx/mise-action@5228313ee0372e111a38da051671ca30fc5a96db # v3.6.3
+      - uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd # v6.3.0
+        with:
+          role-to-assume: ${{ vars.AWS_DEPLOY_ROLE_ARN }}
+          aws-region: ap-northeast-1
+      - name: デプロイする
+        env:
+          TAG: ${{ inputs.tag }}
+        run: |
+          image="$(echo "ghcr.io/${GITHUB_REPOSITORY}/api:${TAG}" | tr '[:upper:]' '[:lower:]')"
+          mise run deploy --image "${image}"
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: always()
+        with:
+          name: evidence-deploy
+          path: app/out/evidence/
diff --git a/app/infra/ecs.tf b/app/infra/ecs.tf
new file mode 100644
index 0000000..02079ec
--- /dev/null
+++ b/app/infra/ecs.tf
@@ -0,0 +1,74 @@
+# APIを動かすECSのクラスタとサービス．
+# デプロイ(mise run deploy)はタスク定義の新しい版を作ってサービスに設定するので，その後の違いは差分から外す．
+
+variable "api_image" {
+  description = "最初に作るタスク定義のイメージ．以降は mise run deploy で替える．"
+  type        = string
+  default     = "ghcr.io/example/compliance-handson/api:v0.0.0"
+}
+
+# APIのタスクを置くネットワーク．インターネットからは直接届かない．
+resource "aws_vpc" "main" {
+  cidr_block = "10.0.0.0/16"
+}
+
+resource "aws_subnet" "private" {
+  vpc_id     = aws_vpc.main.id
+  cidr_block = "10.0.1.0/24"
+}
+
+resource "aws_security_group" "api" {
+  name        = "api"
+  description = "API tasks"
+  vpc_id      = aws_vpc.main.id
+}
+
+resource "aws_ecs_cluster" "prod" {
+  name = "prod"
+
+  setting {
+    name  = "containerInsights"
+    value = "enabled"
+  }
+}
+
+resource "aws_ecs_task_definition" "api" {
+  family                   = "api"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = 256
+  memory                   = 512
+  task_role_arn            = aws_iam_role.task.arn
+  container_definitions = jsonencode([{
+    name         = "api"
+    image        = var.api_image
+    essential    = true
+    portMappings = [{ containerPort = 8080 }]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.app["api"].name
+        awslogs-region        = local.region
+        awslogs-stream-prefix = "api"
+      }
+    }
+  }])
+}
+
+resource "aws_ecs_service" "api" {
+  name            = "api"
+  cluster         = aws_ecs_cluster.prod.id
+  task_definition = aws_ecs_task_definition.api.arn
+  launch_type     = "FARGATE"
+  # この教材では，MiniStackの上でAPIのコンテナを動かさない．本番では台数を決める．
+  desired_count = 0
+
+  network_configuration {
+    subnets         = [aws_subnet.private.id]
+    security_groups = [aws_security_group.api.id]
+  }
+
+  lifecycle {
+    ignore_changes = [task_definition]
+  }
+}
