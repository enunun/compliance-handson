+++ b/app/tests/ops/deploy.test.ts
@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { run } from "../gates/helpers.ts";
+
+// 本番の環境(mise run up で作った環境)で，デプロイを動かして確かめる．
+const image = `ghcr.io/example/compliance-handson/api@sha256:${"1".repeat(64)}`;
+
+function aws(...args: string[]) {
+  return JSON.parse(run("aws", ["ecs", ...args, "--output", "json"]).output);
+}
+
+describe("デプロイ", () => {
+  it("サービスのタスク定義を，指定したイメージの新しい版に替える", () => {
+    const result = run("pnpm", [
+      "exec",
+      "tsx",
+      "tools/ops/deploy.ts",
+      "--image",
+      image,
+    ]);
+    expect(result.status, result.output).toBe(0);
+    const service = aws(
+      "describe-services",
+      "--cluster",
+      "prod",
+      "--services",
+      "api",
+    ).services[0];
+    const task = aws(
+      "describe-task-definition",
+      "--task-definition",
+      service.taskDefinition,
+    ).taskDefinition;
+    expect(task.containerDefinitions[0].image).toBe(image);
+    expect(task.requiresCompatibilities).toEqual(["FARGATE"]);
+    expect(task.networkMode).toBe("awsvpc");
+  });
+});
diff --git a/app/tools/ops/deploy.ts b/app/tools/ops/deploy.ts
new file mode 100644
index 0000000..58d0a87
--- /dev/null
+++ b/app/tools/ops/deploy.ts
@@ -0,0 +1,88 @@
+// APIのイメージをデプロイする．
+// 今のタスク定義のイメージを替えた新しい版を作り，ECSのサービスに設定する．
+// 使い方：mise run deploy --image <イメージ>
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+import { evidenceDir, opsLog, sh, tofuOutput } from "./run.ts";
+
+type ContainerDefinition = { name: string; image: string };
+/** タスク定義のうち，新しい版に引き継ぐ項目． */
+const inherited = [
+  "family",
+  "taskRoleArn",
+  "executionRoleArn",
+  "networkMode",
+  "requiresCompatibilities",
+  "cpu",
+  "memory",
+] as const;
+type TaskDefinition = Partial<
+  Record<(typeof inherited)[number], string | string[]>
+> & { containerDefinitions: ContainerDefinition[] };
+
+function aws(...args: string[]): unknown {
+  return JSON.parse(sh("aws", ["ecs", ...args, "--output", "json"]));
+}
+
+/** サービスのAPIのイメージを image に替え，新しいタスク定義のARNを返す． */
+export function deploy(image: string): string {
+  const cluster = tofuOutput("ecs_cluster");
+  const service = tofuOutput("ecs_service");
+  const current = aws(
+    "describe-services",
+    "--cluster",
+    cluster,
+    "--services",
+    service,
+  ) as { services: { taskDefinition: string }[] };
+  const { taskDefinition } = aws(
+    "describe-task-definition",
+    "--task-definition",
+    current.services[0].taskDefinition,
+  ) as { taskDefinition: TaskDefinition };
+  const containers = taskDefinition.containerDefinitions.map((c) =>
+    c.name === "api" ? { ...c, image } : c,
+  );
+  const input = Object.fromEntries(
+    inherited
+      .filter((key) => taskDefinition[key] !== undefined)
+      .map((key) => [key, taskDefinition[key]]),
+  );
+  const registered = aws(
+    "register-task-definition",
+    "--cli-input-json",
+    JSON.stringify({ ...input, containerDefinitions: containers }),
+  ) as { taskDefinition: { taskDefinitionArn: string } };
+  const arn = registered.taskDefinition.taskDefinitionArn;
+  aws(
+    "update-service",
+    "--cluster",
+    cluster,
+    "--service",
+    service,
+    "--task-definition",
+    arn,
+  );
+  return arn;
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: { image: { type: "string" } },
+  });
+  try {
+    if (!values.image) {
+      throw new Error("--image でイメージを指定する");
+    }
+    const arn = deploy(values.image);
+    writeFileSync(
+      join(evidenceDir("deploy"), "result.json"),
+      `${JSON.stringify({ image: values.image, taskDefinition: arn }, null, 2)}\n`,
+    );
+    opsLog("deploy", true, `${values.image} → ${arn}`);
+  } catch (e) {
+    opsLog("deploy", false, String(e));
+    process.exit(1);
+  }
+}
