index 0000000..e995faa
--- /dev/null
+++ b/app/tools/gates/policy.ts
@@ -0,0 +1,70 @@
+// 組織の共通ルール(policy/ のRego)で，ワークフローと運用項目をconftestで検査する．
+// ルールは組織で1か所に置き，どのリポジトリも同じものを使う前提である．
+import { spawnSync } from "node:child_process";
+import { readdirSync, writeFileSync } from "node:fs";
+import { basename, join } from "node:path";
+import { parseArgs } from "node:util";
+import { evidenceDirOf } from "./trivy.ts";
+
+type Result = {
+  filename: string;
+  namespace: string;
+  failures?: { msg: string }[];
+};
+
+/** conftestで files を namespace のルールで検査し，ファイルごとの結果を返す． */
+function conftest(
+  policy: string,
+  namespace: string,
+  files: string[],
+): Result[] {
+  const result = spawnSync(
+    "conftest",
+    [
+      "test",
+      "--policy",
+      policy,
+      "--namespace",
+      namespace,
+      "--output",
+      "json",
+      ...files,
+    ],
+    { encoding: "utf8" },
+  );
+  if (result.status !== 0 && result.status !== 1) {
+    throw new Error(`conftest failed: ${result.stderr}`);
+  }
+  return JSON.parse(result.stdout);
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      policy: { type: "string", default: "policy" },
+      workflows: { type: "string", default: "../.github/workflows" },
+      items: { type: "string", default: "ops/items.yaml" },
+    },
+  });
+  const workflows = readdirSync(values.workflows)
+    .filter((f) => /\.ya?ml$/.test(f))
+    .map((f) => join(values.workflows, f));
+  const results = [
+    ...conftest(values.policy, "workflows", workflows),
+    ...conftest(values.policy, "items", [values.items]),
+  ];
+  writeFileSync(
+    join(evidenceDirOf("policy"), "conftest.json"),
+    `${JSON.stringify(results, null, 2)}\n`,
+  );
+  const problems = results.flatMap((r) =>
+    (r.failures ?? []).map((f) => `${basename(r.filename)}: ${f.msg}`),
+  );
+  for (const problem of problems) {
+    console.error(problem);
+  }
+  if (problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(`policy: ${results.length} files, 0 failures`);
+}
