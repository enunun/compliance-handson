+# 組織の共通ルール：運用項目(ops/items.yaml)．
+package items
+
+# 人が行う運用項目は，担当者が替わっても同じように行えるよう，手順書を持つ．
+deny contains msg if {
+	some item in input.items
+	item.actor == "人"
+	not item.runbook
+	msg := sprintf("%s: 人が行う運用項目に手順書(runbook)がない", [item.id])
+}
diff --git a/app/policy/workflows.rego b/app/policy/workflows.rego
new file mode 100644
index 0000000..e384dd7
--- /dev/null
+++ b/app/policy/workflows.rego
@@ -0,0 +1,23 @@
+# 組織の共通ルール：GitHub Actionsのワークフロー(.github/workflows/*.yml)．
+package workflows
+
+# GITHUB_TOKEN の権限を既定(リポジトリの設定しだい)のままにせず，ワークフローごとに絞る．
+deny contains msg if {
+	not input.permissions
+	msg := "最上位に permissions を書いていない(GITHUB_TOKEN の権限をワークフローごとに絞る)"
+}
+
+# デプロイの前に，同じジョブでイメージの署名とprovenanceを検証する．
+deny contains msg if {
+	some name, job in input.jobs
+	some i, step in job.steps
+	contains(step.run, "mise run deploy")
+	not verified_before(job, i)
+	msg := sprintf("ジョブ %s が，mise run release:verify より前に mise run deploy を動かしている", [name])
+}
+
+verified_before(job, i) if {
+	some j, step in job.steps
+	j < i
+	contains(step.run, "mise run release:verify")
+}
