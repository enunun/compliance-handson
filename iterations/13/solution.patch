+import { describe, expect, it } from "vitest";
+import { fixture, run } from "./helpers.ts";
+
+/** fixtures/policy/<name> のワークフローと運用項目を，組織の共通ルール(policy/)で検査する． */
+function policy(name: string) {
+  return run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/gates/policy.ts",
+    "--workflows",
+    fixture("policy", name, "workflows"),
+    "--items",
+    fixture("policy", name, "items.yaml"),
+  ]);
+}
+
+describe("gate:policy", () => {
+  it("署名を検証する前にデプロイするジョブがあれば失敗する", () => {
+    const result = policy("unverified-deploy");
+    expect(result.output).toContain(
+      "deploy.yml: ジョブ deploy が，mise run release:verify より前に mise run deploy を動かしている",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("最上位に permissions のないワークフローがあれば失敗する", () => {
+    const result = policy("no-permissions");
+    expect(result.output).toContain(
+      "ci.yml: 最上位に permissions を書いていない",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("人が行う運用項目に手順書がなければ失敗する", () => {
+    const result = policy("no-runbook");
+    expect(result.output).toContain(
+      "items.yaml: exception-requests: 人が行う運用項目に手順書(runbook)がない",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("ルールに合うものだけなら通る", () => {
+    const result = policy("good");
+    expect(result.output).toContain("policy: 2 files, 0 failures");
+    expect(result.status).toBe(0);
+  });
+});
