diff --git a/.github/workflows/rescan.yml b/.github/workflows/rescan.yml
new file mode 100644
index 0000000..51df3b1
--- /dev/null
+++ b/.github/workflows/rescan.yml
@@ -0,0 +1,44 @@
+name: rescan
+
+# リリース済みのイメージを，毎日，最新の脆弱性のデータで検査し直す．
+# リリースの後に公開された脆弱性や，サポートの終了に気づくためである．
+on:
+  schedule:
+    - cron: "37 21 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  packages: read # GHCRからイメージを取得する
+
+jobs:
+  rescan:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: app
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
+        with:
+          fetch-depth: 0
+      - uses: jdx/mise-action@5228313ee0372e111a38da051671ca30fc5a96db # v3.6.3
+      - name: 最新のリリースのイメージを決める
+        id: image
+        run: |
+          tag="$(git describe --tags --abbrev=0 --match 'v*' 2>/dev/null || true)"
+          if [ -z "$tag" ]; then
+            echo "リリースがまだない．"
+            exit 0
+          fi
+          echo "ref=$(echo "ghcr.io/${GITHUB_REPOSITORY}/api:${tag}" | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
+      - name: GHCRにログインする
+        if: steps.image.outputs.ref
+        run: echo "${{ secrets.GITHUB_TOKEN }}" | trivy registry login ghcr.io -u "${{ github.actor }}" --password-stdin
+      - name: 再検査する
+        if: steps.image.outputs.ref
+        run: mise run rescan:image --image "${{ steps.image.outputs.ref }}"
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: always()
+        with:
+          name: evidence-rescan
+          path: app/out/evidence/
