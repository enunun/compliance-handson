diff --git a/app/tests/gates/eol.test.ts b/app/tests/gates/eol.test.ts
new file mode 100644
index 0000000..893523d
--- /dev/null
+++ b/app/tests/gates/eol.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from "vitest";
+import { fixture, run } from "./helpers.ts";
+
+/** fixtures/eol/<name> の mise.toml とDockerfileを，2026-10-04 の時点のデータで検査する． */
+function eol(name: string) {
+  return run("pnpm", [
+    "exec",
+    "tsx",
+    "tools/gates/eol.ts",
+    "--mise",
+    fixture("eol", name, "mise.toml"),
+    "--dockerfile",
+    fixture("eol", name, "Dockerfile"),
+    "--data",
+    fixture("eol", "data"),
+    "--today",
+    "2026-10-04",
+  ]);
+}
+
+describe("gate:eol", () => {
+  it("サポートが終わったベースイメージがあれば失敗する", () => {
+    const result = eol("eol-image");
+    expect(result.output).toContain(
+      "go 1.25 はサポートが終わっている(2026-08-19)",
+    );
+    expect(result.status).toBe(1);
+  });
+
+  it("基準値の日数のうちにサポートが終わるランタイムがあれば失敗する", () => {
+    const result = eol("near-eol");
+    expect(result.output).toContain("nodejs 25 のサポートが2026-12-01に終わる");
+    expect(result.status).toBe(1);
+  });
+
+  it("サポートの終わりが遠いものだけなら通る", () => {
+    const result = eol("ok");
+    expect(result.output).toContain("none near the end of support");
+    expect(result.status).toBe(0);
+  });
+});
