+// 言語のランタイムとベースイメージの，サポートの終了(EOL)を検査する．
+// サポートが終わったもの，基準値の日数のうちに終わるものがあれば失敗する．
+// サポートの終了日は endoflife.date のデータを使う．
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { parseArgs } from "node:util";
+import { parse } from "smol-toml";
+import { readStandards } from "../ops/standards.ts";
+
+/** 調べる対象．where は人が読むための場所である． */
+export type Target = { where: string; product: string; version: string };
+
+/** endoflife.date の版ごとのデータ． */
+export type Release = { name: string; isEol: boolean; eolFrom: string | null };
+
+// mise.toml の道具の名前と，Dockerfileのイメージの名前を，endoflife.date の製品の名前に対応させる．
+const toolProducts: Record<string, string> = { node: "nodejs", go: "go" };
+const imageProducts: Record<string, string> = { node: "nodejs", golang: "go" };
+
+/** mise.toml とDockerfileから，調べる対象を集める． */
+export function collectTargets(
+  miseToml: string,
+  dockerfiles: Record<string, string>,
+): Target[] {
+  const tools = (parse(miseToml).tools ?? {}) as Record<string, string>;
+  const fromTools = Object.entries(tools).flatMap(([tool, version]) =>
+    toolProducts[tool]
+      ? [{ where: `mise.toml: ${tool}`, product: toolProducts[tool], version }]
+      : [],
+  );
+  const fromImages = Object.entries(dockerfiles).flatMap(([file, text]) =>
+    [...text.matchAll(/^FROM\s+(\S+):(\d[\w.]*)/gm)].flatMap(
+      ([, image, tag]) => {
+        const product = imageProducts[image];
+        // タグの先頭の版(1.26-alpine なら 1.26)を使う．
+        const version = tag.match(/^\d+(\.\d+)*/)?.[0];
+        return product && version
+          ? [{ where: `${file}: ${image}:${tag}`, product, version }]
+          : [];
+      },
+    ),
+  );
+  return [...fromTools, ...fromImages];
+}
+
+/** サポートの終了の問題を返す．today は YYYY-MM-DD である． */
+export function checkEol(
+  targets: Target[],
+  releases: Record<string, Release[]>,
+  today: string,
+  warnDays: number,
+): string[] {
+  const limit = new Date(Date.parse(today) + warnDays * 24 * 60 * 60 * 1000)
+    .toISOString()
+    .slice(0, 10);
+  return targets.flatMap((t) => {
+    const release = (releases[t.product] ?? []).find(
+      (r) => t.version === r.name || t.version.startsWith(`${r.name}.`),
+    );
+    if (!release) {
+      return [`${t.where}: ${t.product} ${t.version} のサポートの情報がない`];
+    }
+    if (release.isEol) {
+      return [
+        `${t.where}: ${t.product} ${release.name} はサポートが終わっている(${release.eolFrom})`,
+      ];
+    }
+    if (release.eolFrom && release.eolFrom <= limit) {
+      return [
+        `${t.where}: ${t.product} ${release.name} のサポートが${release.eolFrom}に終わる`,
+      ];
+    }
+    return [];
+  });
+}
+
+/** endoflife.date から製品の版ごとのデータを得る．data があれば，そのディレクトリのJSONを読む． */
+async function loadReleases(products: string[], data?: string) {
+  const entries = await Promise.all(
+    products.map(async (p) => {
+      const json = data
+        ? JSON.parse(readFileSync(join(data, `${p}.json`), "utf8"))
+        : await (
+            await fetch(`https://endoflife.date/api/v1/products/${p}/`)
+          ).json();
+      return [p, json.result.releases as Release[]] as const;
+    }),
+  );
+  return Object.fromEntries(entries);
+}
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      mise: { type: "string", default: "../mise.toml" },
+      dockerfile: {
+        type: "string",
+        multiple: true,
+        default: ["apps/api/Dockerfile"],
+      },
+      data: { type: "string" },
+      ops: { type: "string", default: "ops" },
+      today: { type: "string", default: new Date().toISOString().slice(0, 10) },
+    },
+  });
+  const targets = collectTargets(
+    readFileSync(values.mise, "utf8"),
+    Object.fromEntries(
+      values.dockerfile.map((f) => [f, readFileSync(f, "utf8")]),
+    ),
+  );
+  const releases = await loadReleases(
+    [...new Set(targets.map((t) => t.product))],
+    values.data,
+  );
+  const problems = checkEol(
+    targets,
+    releases,
+    values.today,
+    readStandards(values.ops).eol.warn_days,
+  );
+  for (const problem of problems) {
+    console.error(problem);
+  }
+  if (problems.length > 0) {
+    process.exit(1);
+  }
+  console.log(`eol: ${targets.length} targets, none near the end of support`);
+}
