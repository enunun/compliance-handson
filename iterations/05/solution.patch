+// DockerfileとOpenTofuのコードの設定の誤りを，Trivyで検査する．
+// 基準値の重大度以上の誤りがあれば失敗する．例外に載った誤りは，期限まで外す．
+import { parseArgs } from "node:util";
+import { evidenceDirOf, runTrivy } from "./trivy.ts";
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      target: { type: "string", default: "." },
+      ops: { type: "string", default: "ops" },
+      exceptions: { type: "string", default: "ops/exceptions.yaml" },
+    },
+  });
+  const { status } = runTrivy({
+    args: [
+      "config",
+      "--skip-dirs",
+      "**/node_modules,**/.terraform,tests/gates/fixtures",
+      values.target,
+    ],
+    evidenceDir: evidenceDirOf("config"),
+    ops: values.ops,
+    exceptions: values.exceptions,
+  });
+  process.exit(status);
+}
diff --git a/app/tools/gates/image.ts b/app/tools/gates/image.ts
new file mode 100644
index 0000000..3b4b12b
--- /dev/null
+++ b/app/tools/gates/image.ts
@@ -0,0 +1,33 @@
+// コンテナイメージを，Trivyで検査する．
+// 基準値の重大度以上の脆弱性があるか，サポートが終わったOSを使っていれば失敗する．
+import { readFileSync } from "node:fs";
+import { parseArgs } from "node:util";
+import { evidenceDirOf, runTrivy } from "./trivy.ts";
+
+type Report = {
+  Metadata?: { OS?: { Family: string; Name: string; EOSL?: boolean } };
+};
+
+if (import.meta.main) {
+  const { values } = parseArgs({
+    options: {
+      image: { type: "string", default: "app-api:local" },
+      ops: { type: "string", default: "ops" },
+      exceptions: { type: "string", default: "ops/exceptions.yaml" },
+    },
+  });
+  const { status, report } = runTrivy({
+    args: ["image", "--scanners", "vuln", values.image],
+    evidenceDir: evidenceDirOf("image"),
+    ops: values.ops,
+    exceptions: values.exceptions,
+  });
+  const os = (JSON.parse(readFileSync(report, "utf8")) as Report).Metadata?.OS;
+  if (os?.EOSL) {
+    console.error(
+      `${values.image}: ${os.Family} ${os.Name} はサポートが終わっている`,
+    );
+    process.exit(1);
+  }
+  process.exit(status);
+}
